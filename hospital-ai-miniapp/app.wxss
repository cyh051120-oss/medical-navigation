/**app.wxss**/
/* 任务 41：设计令牌集中在 styles/tokens.wxss，这里只 @import 并保留任务 16 的
   缩放/高对比契约（--mhp-scale 与 .is-hc 映射必须留在本文件：a11y 规范扫描本文件）。 */
@import './styles/tokens.wxss';
@import './styles/icons.wxss';

page {
  /* 现代背景质感 */
  background-color: var(--bg-main);
  /* 首选无衬线字体，增强西文与数字观感 */
  font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
  height: 100%;
  -webkit-font-smoothing: antialiased;

  /* 任务 12/16：全局缩放基准；由 shared/ui/a11y.ts 写入页面根节点覆盖
     （scale = fontSize / 14），所有页面字号统一写 calc(Nrpx * var(--mhp-scale))。 */
  --mhp-scale: 1;

  /* P1-31 布局缩放：唯一默认定义。字号放大不受限，但侧栏宽度这类占位几何必须有上限。
     shared/ui/a11y.ts 的 layoutScale = min(scale, 1.2)，页面根节点内联覆盖此默认值
     （--mhp-layout-scale: {{layoutScale}}）；未绑定的页面退回 1（侧栏不放大，内容区安全）。
     后续 A11Y sweep：新页面请复用同一绑定，不要用它驱动 font-size。 */
  --mhp-layout-scale: 1;
}

/* 任务 16：全局高对比入口。任意页面根节点加 `is-hc` 即把高对比令牌映射到语义令牌，
   页面内所有 color/background 经 var(--*) 自动切换，无需逐页重写。
   settings.wxss 保留 `.settings.is-hc` 等价作用域块以兼容既有契约（值相同）。 */
.is-hc {
  --bg-main: var(--mhp-hc-bg);
  --bg-accent: var(--mhp-hc-surface);
  --bg-input: var(--mhp-hc-bg);
  --bg-warm: var(--mhp-hc-surface);
  --bg-elevated: var(--mhp-hc-surface);
  --surface-action: var(--mhp-hc-accent);
  --color-on-action: var(--mhp-hc-bg);
  --color-on-primary: var(--mhp-hc-bg);
  --color-decoration: var(--mhp-hc-accent);
  --color-warm: var(--mhp-hc-accent);
  --border-strong: var(--mhp-hc-border);
  --border-subtle: var(--mhp-hc-border);
  --bg-card: var(--mhp-hc-surface);
  --text-title: var(--mhp-hc-text);
  --text-body: var(--mhp-hc-text);
  --text-caption: var(--mhp-hc-text);
  --color-primary: var(--mhp-hc-accent);
  /* P1-36：danger 用独立 HC 通道，避免与 primary（#FFD400）同色而抹掉
     「错误/离线」与「主操作/已连接」的色彩区分。 */
  --color-danger: var(--mhp-hc-danger);
}

/* ===========================================================================
   兼容路由页的左侧导航栏布局；正式 workspace 启动页已改为底部导航。
   8 个页面根节点加 `.app-shell`，并带 `{{sidebarCollapsed ? 'is-collapsed' : ''}}`；
   侧栏组件（app-sidebar）固定定位，页面根节点用 margin-left: var(--mhp-sidebar-w)
   为其让位——页面背景与 page 背景同色，故左侧让位区无可见接缝。
   宽度随 **--mhp-layout-scale**（上限 1.2，见 a11y.ts）而非 --mhp-scale 缩放：
   fontSize=32 时展开仍 248×1.2=297.6rpx ≤ 300rpx，内容区 ≥60%；展开 248rpx /
   收起 96rpx 与组件内 .sb 共用同一变量，保持一致。
   像素一律 rpx：a11y 静态扫描要求 app.wxss 与 8 页 wxss 零裸 px。
   =========================================================================== */

.app-shell {
  --mhp-sidebar-w: calc(248rpx * var(--mhp-layout-scale));
  margin-left: var(--mhp-sidebar-w);
  transition: margin-left var(--motion-normal) var(--ease-standard);
}

.app-shell.is-collapsed {
  --mhp-sidebar-w: calc(96rpx * var(--mhp-layout-scale));
}

/* ===========================================================================
   任务 41：共享状态样式（空态 / 加载 / 错误）。
   一套类在 8 个页面复用；页面只负责自己的布局类，状态外观一律来自这里。
   =========================================================================== */

/* ----- 空态 ----- */
.mhp-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: var(--mhp-space-12) var(--mhp-space-10) var(--mhp-space-8);
}

.mhp-empty--inline {
  align-items: stretch;
  margin: var(--mhp-space-6) 0;
  padding: var(--mhp-space-8) var(--mhp-space-6);
  border-radius: var(--radius-md);
  background: var(--bg-main);
}

/* 空状态徽标是装饰尺寸，不是文字；随 layoutScale 有限放大（最高 1.2）。
   正文仍随 --mhp-scale 全量缩放，避免 32 字号下巨型徽标占掉可操作区域。 */
.mhp-empty__badge {
  width: calc(108rpx * var(--mhp-layout-scale));
  height: calc(108rpx * var(--mhp-layout-scale));
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-lg);
  color: var(--color-primary);
  background: var(--bg-accent);
  opacity: 0.9;
}

.mhp-empty__badge .mhp-ico {
  width: calc(48rpx * var(--mhp-layout-scale));
  height: calc(48rpx * var(--mhp-layout-scale));
}

.mhp-empty__text {
  display: block;
  margin: var(--mhp-space-6) 0 var(--mhp-space-8);
  font-size: calc(28rpx * var(--mhp-scale));
  line-height: var(--mhp-lh-body);
  color: var(--text-body);
  text-align: center;
}

.mhp-empty--inline .mhp-empty__text {
  margin-top: var(--mhp-space-4);
  margin-bottom: var(--mhp-space-3);
}

.mhp-empty__action {
  margin-top: var(--mhp-space-4);
}

/* ----- 错误 ----- */
.mhp-error {
  display: block;
  font-size: calc(24rpx * var(--mhp-scale));
  line-height: var(--mhp-lh-caption);
  color: var(--color-danger);
}

.mhp-error--boxed {
  margin-bottom: var(--mhp-space-6);
  padding: var(--mhp-space-4) var(--mhp-space-6);
  border-radius: var(--radius-md);
  background: var(--bg-card);
  box-shadow: var(--shadow-sm);
  border: 2rpx solid var(--color-danger);
}

.mhp-error__text {
  display: block;
  font-size: calc(24rpx * var(--mhp-scale));
  line-height: var(--mhp-lh-caption);
  color: var(--color-danger);
}

/* ----- 加载 ----- */
.mhp-loading {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--mhp-space-3);
  padding: var(--mhp-space-6) 0;
}

.mhp-loading__spinner {
  width: calc(32rpx * var(--mhp-scale));
  height: calc(32rpx * var(--mhp-scale));
  box-sizing: border-box;
  border: 4rpx solid var(--bg-main);
  border-top-color: var(--color-primary);
  border-radius: 50%;
  animation: mhp-spin var(--motion-spin) linear infinite;
}

.mhp-loading__text {
  font-size: calc(24rpx * var(--mhp-scale));
  line-height: var(--mhp-lh-caption);
  color: var(--text-caption);
}

@keyframes mhp-spin {
  to {
    transform: rotate(360deg);
  }
}

/* 全页面同一组操作语义：代替各功能区重复的 btn CSS。 */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  min-height: 88rpx;
  padding: var(--mhp-space-4) var(--mhp-space-6);
  border: 2rpx solid transparent;
  border-radius: var(--radius-md);
  text-align: center;
  font-size: calc(28rpx * var(--mhp-scale));
  line-height: var(--mhp-lh-body);
  font-weight: var(--mhp-fw-semibold);
}

.btn--primary {
  color: var(--color-on-primary);
  background: var(--color-primary);
  box-shadow: var(--shadow-neon);
}

.btn--ghost {
  font-size: calc(24rpx * var(--mhp-scale));
  color: var(--color-primary);
  background: var(--bg-accent);
  border-color: transparent;
}

.btn--danger {
  font-size: calc(24rpx * var(--mhp-scale));
  color: var(--color-danger);
  background: var(--bg-warm);
  border-color: transparent;
}

.is-hc .btn--primary {
  color: var(--mhp-hc-bg);
  box-shadow: none;
}

/* 字号放大时重组同行字段和工具栏，而非强行把控件缩小或截断。 */
.is-large-text .hero {
  flex-wrap: wrap;
}

.is-large-text .hero__add {
  margin-left: 0;
}

.is-large-text .tl-card__head,
.is-large-text .toolbar,
.is-large-text .statusbar,
.is-large-text .row__head {
  flex-wrap: wrap;
}

.is-large-text .modes {
  flex-direction: column;
}

.is-large-text .compose__actions,
.is-large-text .select__tools,
.is-large-text .preview__actions,
.is-large-text .poster__actions,
.is-large-text .editor__actions {
  flex-wrap: wrap;
}

.is-large-text .settings .row,
.settings.is-large-text .row {
  flex-wrap: wrap;
}

/* 独立路由页的根节点同时是 section 和字号态，不属于自己的后代。 */
.is-large-text .select__head,
.brief.is-large-text .select__head,
.is-large-text .note__head,
.notes.is-large-text .note__head,
.is-large-text .mem-item,
.settings.is-large-text .mem-item {
  flex-wrap: wrap;
}

.is-large-text .brief .select > .row,
.brief.is-large-text .select > .row {
  flex-wrap: wrap;
}

/* 编辑区与只读正文的差异必须可见，尤其个人档案的单行输入。 */
.field__input,
.field__area,
.field__textarea,
.compose__area,
.editor__area,
.picker,
.mem-form__input {
  border: 2rpx solid var(--border-subtle);
  background: var(--bg-input);
  border-radius: var(--radius-sm);
}

/* 占位提示跟随语义色：高对比下不沿用系统默认深灰。 */
.mhp-placeholder {
  color: var(--text-caption);
}

/* Page grammar for journal sections and user-focused screens. */
.mhp-page-kicker {
  display: flex;
  align-items: center;
  gap: var(--mhp-space-3);
  margin-bottom: var(--mhp-space-4);
  font-size: calc(23rpx * var(--mhp-scale));
  font-weight: var(--mhp-fw-semibold);
  letter-spacing: 1rpx;
  line-height: var(--mhp-lh-caption);
  color: var(--color-primary);
}
.mhp-page-kicker__dot {
  width: 12rpx;
  height: 12rpx;
  flex: none;
  border-radius: 50%;
  background: var(--color-primary);
}
.hero__add-plus {
  display: inline-block;
  margin-right: var(--mhp-space-2);
  font-size: calc(28rpx * var(--mhp-scale));
  font-weight: var(--mhp-fw-semibold);
}
