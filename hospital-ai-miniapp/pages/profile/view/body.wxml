<!-- pages/profile/view/body.wxml — 最小个人档案主体（任务 14）。
     双宿主共享：wrapper 页与 workspace section 组件都 include 本文件；
     根壳（.profile 的 class / inline scale 变量）与 <app-sidebar> 由宿主提供，不在此处。 -->
  <view class="profile-hero">
    <text class="profile-hero__title">个人档案</text>
    <text class="profile-hero__sub">资料只保存在本机，可随时修改或清除</text>
  </view>

  <view class="profile-card">
    <view class="field">
      <text class="field__label">称呼</text>
      <input
        class="field__input"
        placeholder="例如：李阿姨"
        value="{{form.name}}"
        data-key="name"
        bindinput="onFieldInput"
        maxlength="20"
      />
    </view>

    <view class="field">
      <text class="field__label">年龄段</text>
      <picker mode="selector" range="{{ageRanges}}" value="{{ageRangeIndex}}" bindchange="onAgeRangeChange">
        <view class="field__picker {{form.ageRange ? 'is-filled' : ''}}">
          {{form.ageRange ? form.ageRange : ageRangePlaceholder}}
        </view>
      </picker>
    </view>

    <view class="field">
      <text class="field__label">性别（可选）</text>
      <view class="gender">
        <view
          wx:for="{{genderOptions}}"
          wx:key="value"
          class="gender__btn {{form.gender === item.value ? 'is-active' : ''}}"
          data-value="{{item.value}}"
          bindtap="setGender"
          aria-role="radio"
          aria-checked="{{form.gender === item.value}}"
          aria-label="{{item.label}}"
        >
          {{item.label}}
        </view>
      </view>
    </view>
  </view>

  <view class="profile-card">
    <view class="field field--block">
      <text class="field__label">过敏</text>
      <textarea
        class="field__textarea"
        placeholder="药物或食物过敏，如：青霉素"
        value="{{form.allergies}}"
        data-key="allergies"
        bindinput="onFieldInput"
        maxlength="200"
        auto-height
      />
    </view>

    <view class="field field--block">
      <text class="field__label">长期用药</text>
      <textarea
        class="field__textarea"
        placeholder="长期服用的药，如：氨氯地平"
        value="{{form.medications}}"
        data-key="medications"
        bindinput="onFieldInput"
        maxlength="300"
        auto-height
      />
    </view>

    <view class="field field--block">
      <text class="field__label">既往情况</text>
      <textarea
        class="field__textarea"
        placeholder="既往病史或手术，如：高血压"
        value="{{form.history}}"
        data-key="history"
        bindinput="onFieldInput"
        maxlength="300"
        auto-height
      />
    </view>
  </view>

  <view class="mhp-error mhp-error--boxed" wx:if="{{errorText}}">
    <text class="mhp-error__text">{{errorText}}</text>
  </view>

  <view class="profile-actions">
    <view class="btn btn--primary" bindtap="onSave" aria-role="button" aria-label="{{saveText}}">{{saveText}}</view>
    <view class="btn btn--danger" wx:if="{{hasRecord}}" bindtap="onClear" aria-role="button" aria-label="{{clearText}}">{{clearText}}</view>
  </view>

  <view class="profile-meta" wx:if="{{hasRecord}}">
    <view class="profile-meta__row">
      <text class="profile-meta__label">{{labels.createdAt}}</text>
      <text class="profile-meta__value">{{createdAtLabel}}</text>
    </view>
    <view class="profile-meta__row">
      <text class="profile-meta__label">{{labels.updatedAt}}</text>
      <text class="profile-meta__value">{{updatedAtLabel}}</text>
    </view>
  </view>
