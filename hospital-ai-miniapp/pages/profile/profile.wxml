<!-- pages/profile/profile.wxml — 最小个人档案 wrapper 页（任务 14）。
     重构后本页为薄 wrapper：根壳（.profile + app-shell + is-hc/is-collapsed + inline scale）
     ＋ 全局侧栏 ＋ include 共享主体 view/body.wxml（与 workspace section 共用）。
     任务 16：根节点内联 --mhp-scale（shared/ui/a11y.ts 写入），高对比加 is-hc。 -->
<view class="profile app-shell {{highContrast ? 'is-hc' : ''}} {{sidebarCollapsed ? 'is-collapsed' : ''}}" style="--mhp-scale: {{scale}}; --mhp-layout-scale: {{layoutScale}}">
  <app-sidebar current="profile" collapsed="{{sidebarCollapsed}}" scale="{{scale}}" bind:toggle="onSidebarToggle" />

  <include src="./view/body.wxml"/>
</view>
