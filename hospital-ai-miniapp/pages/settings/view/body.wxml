<!-- pages/settings/view/body.wxml — 设置主体（任务 15）。
     双宿主共享：wrapper 页与 workspace section 组件都 include 本文件；
     根壳（.settings 的 class / inline scale 变量）与 <app-sidebar> 由宿主提供，不在此处。
     隐私授权弹层（position:fixed, z-index:100）位于主体最前，顺序同原页面。 -->
  <view class="privacy-overlay" wx:if="{{privacyAuthPrompt}}" aria-role="alert">
    <view class="privacy-overlay__panel">
      <text class="privacy-overlay__title">需要隐私授权</text>
      <text class="privacy-overlay__text">为继续本次操作，需要你先同意平台的隐私保护指引。协议全文可在下方查看。</text>
      <view class="privacy-actions">
        <button
          id="privacy-agree-overlay"
          class="privacy-btn"
          open-type="agreePrivacyAuthorization"
          bindagreeprivacyauthorization="onAgreePrivacyAuthorization"
          aria-label="同意平台隐私保护指引"
        >同意并继续</button>
        <view class="btn btn--ghost" bindtap="onDenyPrivacyAuthorization" aria-role="button" aria-label="暂不同意隐私授权">暂不同意</view>
        <view class="btn btn--ghost" bindtap="onOpenPrivacyContract" aria-role="button" aria-label="查看隐私保护指引全文">查看协议全文</view>
      </view>
    </view>
  </view>
  <view class="settings-hero">
    <text class="settings-hero__title">设置</text>
    <text class="settings-hero__sub">显示、隐私、数据与 AI 记忆都在这里管理；资料只保存在本机。</text>
  </view>

  <view class="card">
    <text class="card__title">显示与无障碍</text>

    <view class="row row--block">
      <view class="row__head">
        <text class="row__label">字号</text>
        <text class="row__value">{{fontSize}}</text>
      </view>
      <slider
        class="slider"
        min="{{fontMin}}"
        max="{{fontMax}}"
        step="1"
        value="{{fontSize}}"
        show-value
        activeColor="{{accentColor}}"
        bindchanging="onFontSizeChanging"
        bindchange="onFontSizeChange"
      />
      <text class="row__hint">范围 {{fontMin}}–{{fontMax}}，调整后立即生效。</text>
    </view>

    <view class="row">
      <view class="row__main">
        <text class="row__label">高对比模式</text>
        <text class="row__hint">开启后使用高对比配色，文字更清晰。</text>
      </view>
      <switch checked="{{highContrast}}" bindchange="onHighContrastChange" />
    </view>

    <view class="row">
      <view class="row__main">
        <text class="row__label">语音输入</text>
        <text class="row__hint">{{a11y.keyboardMic}}</text>
      </view>
    </view>
  </view>

  <view class="card">
    <text class="card__title">AI 外部调用</text>
    <view class="row">
      <view class="row__main">
        <text class="row__label">允许外部 AI 调用</text>
        <text class="row__hint">{{privacy.externalAiOffByDefault}}</text>
      </view>
      <switch checked="{{aiEnabled}}" bindchange="onAiEnabledChange" />
    </view>
    <view class="scope">
      <text class="scope__title">发送范围（开启前需同意）</text>
      <text class="scope__text">{{privacy.externalAiSendScope}}</text>
    </view>
    <text class="row__hint row__hint--status">{{consentText}}</text>
    <view class="row" wx:if="{{demoVisible}}">
      <view class="row__main">
        <text class="row__label">{{demo.toggleLabel}}</text>
        <text class="row__hint">{{demo.toggleHint}}</text>
      </view>
      <switch checked="{{demoMode}}" bindchange="onDemoModeChange" />
    </view>
  </view>

  <view class="card">
    <text class="card__title">{{memory.title}}</text>
    <text class="card__intro">{{memory.intro}}</text>

    <view class="row">
      <view class="row__main">
        <text class="row__label">{{memory.autoLabel}}</text>
        <text class="row__hint">{{memory.autoHint}}</text>
      </view>
      <switch checked="{{autoMemory}}" bindchange="onAutoMemoryChange" />
    </view>

    <view class="mhp-empty mhp-empty--inline" wx:if="{{!hasMemories}}">
      <text class="mhp-empty__text">{{memory.empty}}</text>
    </view>

    <view class="mem-list" wx:else>
      <view class="mem-item" wx:for="{{memories}}" wx:key="id">
        <view class="mem-item__main" data-id="{{item.id}}" bindtap="onMemoryEdit" aria-role="button" aria-label="编辑记忆：{{item.text}}">
          <view class="mem-item__head">
            <text class="mem-badge mem-badge--{{item.source}}">{{item.sourceLabel}}</text>
            <text class="mem-item__text">{{item.text}}</text>
          </view>
        </view>
        <view class="mem-item__actions">
          <switch checked="{{item.enabled}}" data-id="{{item.id}}" bindchange="onMemoryToggle" />
          <view class="btn btn--ghost" data-id="{{item.id}}" bindtap="onMemoryDelete" aria-role="button" aria-label="删除这条记忆">{{buttons.delete}}</view>
        </view>
      </view>
    </view>

    <view class="mem-form">
      <text class="mem-form__hint" wx:if="{{editingId}}">{{memory.editingHint}}</text>
      <input
        class="mem-form__input"
        placeholder="{{memory.addPlaceholder}}"
        value="{{memoryDraft}}"
        bindinput="onMemoryDraftInput"
        maxlength="60"
      />
      <view class="mem-form__actions">
        <view class="btn btn--primary" bindtap="onMemorySave" aria-role="button" aria-label="{{buttons.save}}">{{buttons.save}}</view>
        <view class="btn btn--ghost" wx:if="{{editingId}}" bindtap="onMemoryCancelEdit" aria-role="button" aria-label="{{buttons.cancel}}">{{buttons.cancel}}</view>
      </view>
      <text class="mhp-error" wx:if="{{memoryError}}">{{memoryError}}</text>
    </view>

    <view class="btn btn--danger" wx:if="{{hasMemories}}" bindtap="onMemoryClearAll" aria-role="button" aria-label="清空所有 AI 记忆">{{memory.clearAllButton}}</view>
  </view>

  <view class="card">
    <text class="card__title">数据</text>

    <view class="row row--block">
      <text class="row__label">{{exportCopy.button}}</text>
      <text class="row__hint">{{exportCopy.notice}}</text>
      <view class="btn btn--primary" bindtap="onExport" aria-role="button" aria-label="{{exportCopy.button}}">{{exportCopy.button}}</view>
      <text class="result" wx:if="{{exportPath}}">已导出到：{{exportPath}}</text>
      <text class="result mhp-error" wx:if="{{exportError}}">{{exportError}}</text>
    </view>

    <view class="divider"></view>

    <view class="row row--block">
      <text class="row__label">{{exportCopy.exportsTitle}}</text>
      <text class="row__hint">{{exportCopy.exportsNotice}}</text>
      <text class="result mhp-error" wx:if="{{exportListError}}">{{exportListError}}</text>
      <view class="mem-list" wx:elif="{{hasExports}}">
        <view class="mem-item" wx:for="{{exportFiles}}" wx:key="path">
          <view class="mem-item__main">
            <view class="mem-item__head">
              <text class="mem-item__text">{{item.name}}</text>
              <text class="mem-badge mem-badge--legacy" wx:if="{{item.legacy}}">旧版导出</text>
            </view>
            <text class="row__hint">{{item.sizeLabel}}</text>
          </view>
          <view class="mem-item__actions">
            <view class="btn btn--ghost" data-path="{{item.path}}" bindtap="onDeleteExport" aria-role="button" aria-label="删除导出文件 {{item.name}}">{{buttons.delete}}</view>
          </view>
        </view>
      </view>
      <text class="result" wx:else>{{exportCopy.exportsEmpty}}</text>
      <view class="btn btn--ghost" wx:if="{{hasExports}}" bindtap="onClearExports" aria-role="button" aria-label="清空所有导出文件">{{exportCopy.clearExports}}</view>
    </view>

    <view class="divider"></view>

    <view class="row row--block">
      <text class="row__label">{{wipeCopy.button}}</text>
      <text class="row__hint">{{wipeCopy.firstContent}}</text>
      <view class="btn btn--danger" bindtap="onWipe" aria-role="button" aria-label="{{wipeCopy.button}}">{{wipeCopy.button}}</view>
      <text class="result mhp-error" wx:if="{{wipeError}}">{{wipeCopy.failedHint}}：{{wipeError}}</text>
      <view class="btn btn--ghost" wx:if="{{wipeError}}" bindtap="onWipe" aria-role="button" aria-label="{{wipeCopy.retryButton}}">{{wipeCopy.retryButton}}</view>
    </view>

    <text class="result" wx:if="{{resultText}}">{{resultText}}</text>
  </view>

  <view class="card">
    <view class="row__head">
      <text class="card__title">隐私授权</text>
      <text class="mem-badge" wx:if="{{privacyNeedAuth}}">待授权</text>
    </view>
    <text class="para">{{privacyStatusText}}</text>
    <view class="scope" wx:if="{{privacyContractName}}">
      <text class="scope__title">平台隐私协议</text>
      <text class="scope__text">{{privacyContractName}}</text>
    </view>
    <view class="privacy-actions">
      <button
        id="privacy-agree-section"
        class="privacy-btn"
        open-type="agreePrivacyAuthorization"
        bindagreeprivacyauthorization="onAgreePrivacyAuthorization"
        aria-label="同意平台隐私保护指引"
      >同意平台隐私保护指引</button>
      <view class="btn btn--ghost" bindtap="onOpenPrivacyContract" aria-role="button" aria-label="查看隐私保护指引全文">查看协议全文</view>
    </view>
    <text class="result mhp-error" wx:if="{{privacyAuthError}}">{{privacyAuthError}}</text>
  </view>

  <view class="card">
    <text class="card__title">隐私说明</text>
    <text class="para">{{privacy.localFirst}}</text>
    <text class="para">{{privacy.externalAiOffByDefault}}</text>
    <text class="para">{{privacy.externalAiConsent}}</text>
    <text class="para">{{privacy.localDataControl}}</text>
  </view>

  <view class="card">
    <text class="card__title">非医疗器械声明</text>
    <text class="para">{{about.nonDevice}}</text>
    <text class="para">{{disclaimers.notDiagnosis}}</text>
    <text class="para">{{disclaimers.notProfessional}}</text>
  </view>

  <view class="card">
    <text class="card__title">关于</text>
    <text class="para">{{about.aboutText}}</text>
    <text class="para">{{about.version}}</text>
  </view>
