/* pages/settings/settings.wxss — 设置（任务 15）。
   任务 41：只消费 styles/tokens.wxss；字号四档统一；空/错误态复用 app.wxss 共享类。
   高对比：本页根节点 .settings.is-hc 把 --mhp-hc-* 映射到语义令牌（settings 规范依赖
   本文件出现 --mhp-hc-bg / --mhp-hc-text，故保留该作用域块）。 */

.settings {
  min-height: 100%;
  box-sizing: border-box;
  padding: var(--mhp-space-6) var(--mhp-space-7) var(--mhp-space-11);
  background: var(--bg-main);
  color: var(--text-body);
}

.settings.is-hc {
  --bg-main: var(--mhp-hc-bg);
  --bg-card: var(--mhp-hc-surface);
  --text-title: var(--mhp-hc-text);
  --text-body: var(--mhp-hc-text);
  --text-caption: var(--mhp-hc-text);
  --color-primary: var(--mhp-hc-accent);
  --color-danger: var(--mhp-hc-accent);
}

.settings.is-hc .card {
  border: 2rpx solid var(--mhp-hc-border);
}

/* page title tier */
.settings-hero {
  padding: var(--mhp-space-4) var(--mhp-space-2) var(--mhp-space-7);
}

.settings-hero__title {
  display: block;
  font-size: calc(44rpx * var(--mhp-scale));
  line-height: var(--mhp-lh-title);
  font-weight: var(--mhp-fw-semibold);
  color: var(--text-title);
}

/* caption tier */
.settings-hero__sub {
  display: block;
  margin-top: var(--mhp-space-3);
  font-size: calc(24rpx * var(--mhp-scale));
  line-height: var(--mhp-lh-caption);
  color: var(--text-caption);
}

.card {
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-md);
  padding: var(--mhp-space-7) var(--mhp-space-8);
  margin-bottom: var(--mhp-space-7);
}

/* section title tier */
.card__title {
  display: block;
  font-size: calc(32rpx * var(--mhp-scale));
  line-height: var(--mhp-lh-title);
  font-weight: var(--mhp-fw-semibold);
  color: var(--text-title);
}

.card__intro {
  display: block;
  margin-top: var(--mhp-space-3);
  font-size: calc(24rpx * var(--mhp-scale));
  line-height: var(--mhp-lh-caption);
  color: var(--text-caption);
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--mhp-space-5);
  padding: var(--mhp-space-6) 0;
  border-bottom: 2rpx solid var(--bg-main);
}

.row:last-child {
  border-bottom: none;
}

.row--block {
  display: block;
}

.row__head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.row__main {
  flex: 1;
  min-width: 0;
}

/* body tier */
.row__label {
  font-size: calc(28rpx * var(--mhp-scale));
  line-height: var(--mhp-lh-body);
  font-weight: var(--mhp-fw-semibold);
  color: var(--text-body);
}

.row__value {
  font-size: calc(28rpx * var(--mhp-scale));
  line-height: var(--mhp-lh-body);
  font-weight: var(--mhp-fw-semibold);
  color: var(--color-primary);
}

/* caption tier */
.row__hint {
  display: block;
  margin-top: var(--mhp-space-2);
  font-size: calc(24rpx * var(--mhp-scale));
  line-height: var(--mhp-lh-caption);
  color: var(--text-caption);
}

.row__hint--status {
  margin-top: var(--mhp-space-4);
}

.slider {
  margin: var(--mhp-space-2) 0;
}

.scope {
  padding: var(--mhp-space-5) var(--mhp-space-6);
  border-radius: var(--radius-md);
  background: var(--bg-main);
}

.scope__title {
  display: block;
  font-size: calc(24rpx * var(--mhp-scale));
  line-height: var(--mhp-lh-caption);
  font-weight: var(--mhp-fw-semibold);
  color: var(--text-body);
}

.scope__text {
  display: block;
  margin-top: var(--mhp-space-2);
  font-size: calc(24rpx * var(--mhp-scale));
  line-height: var(--mhp-lh-caption);
  color: var(--text-caption);
}

/* body tier */
.para {
  display: block;
  margin-top: var(--mhp-space-4);
  font-size: calc(28rpx * var(--mhp-scale));
  line-height: var(--mhp-lh-body);
  color: var(--text-body);
}

.mem-list {
  margin: var(--mhp-space-5) 0;
  display: flex;
  flex-direction: column;
  gap: var(--mhp-space-4);
}

.mem-item {
  display: flex;
  align-items: center;
  gap: var(--mhp-space-4);
  padding: var(--mhp-space-5) var(--mhp-space-6);
  border-radius: var(--radius-md);
  background: var(--bg-main);
}

.mem-item__main {
  flex: 1;
  min-width: 0;
}

.mem-item__head {
  display: flex;
  align-items: center;
  gap: var(--mhp-space-4);
}

/* caption tier */
.mem-badge {
  flex: none;
  padding: var(--mhp-space-1) var(--mhp-space-4);
  border-radius: var(--radius-sm);
  font-size: calc(24rpx * var(--mhp-scale));
  line-height: var(--mhp-lh-caption);
  color: var(--color-primary);
  background: var(--bg-card);
}

.mem-badge--ai {
  color: var(--bg-card);
  background: var(--color-primary);
}

/* body tier */
.mem-item__text {
  flex: 1;
  min-width: 0;
  font-size: calc(28rpx * var(--mhp-scale));
  line-height: var(--mhp-lh-body);
  color: var(--text-body);
  word-break: break-all;
}

.mem-item__actions {
  flex: none;
  display: flex;
  align-items: center;
  gap: var(--mhp-space-3);
}

.mem-form {
  margin-top: var(--mhp-space-5);
}

.mem-form__hint {
  display: block;
  margin-bottom: var(--mhp-space-3);
  font-size: calc(24rpx * var(--mhp-scale));
  line-height: var(--mhp-lh-caption);
  color: var(--color-primary);
}

/* body tier */
.mem-form__input {
  width: 100%;
  box-sizing: border-box;
  height: 72rpx;
  padding: 0 var(--mhp-space-6);
  border-radius: var(--radius-sm);
  font-size: calc(28rpx * var(--mhp-scale));
  line-height: var(--mhp-lh-body);
  color: var(--text-body);
  background: var(--bg-main);
}

.mem-form__actions {
  display: flex;
  gap: var(--mhp-space-4);
  margin-top: var(--mhp-space-4);
}

.divider {
  height: 2rpx;
  margin: var(--mhp-space-6) 0;
  background: var(--bg-main);
}

/* body tier */
.btn {
  padding: var(--mhp-space-6) 0;
  border-radius: var(--radius-md);
  text-align: center;
  font-size: calc(28rpx * var(--mhp-scale));
  line-height: var(--mhp-lh-body);
  font-weight: var(--mhp-fw-semibold);
}

.btn--primary {
  color: var(--bg-card);
  background: var(--color-primary);
  box-shadow: var(--shadow-neon);
}

.btn--danger {
  color: var(--color-danger);
  background: var(--bg-card);
  border: 2rpx solid var(--color-danger);
}

/* caption tier */
.btn--ghost {
  padding: var(--mhp-space-4) var(--mhp-space-6);
  font-size: calc(24rpx * var(--mhp-scale));
  line-height: var(--mhp-lh-caption);
  color: var(--color-primary);
  background: var(--bg-card);
  box-shadow: var(--shadow-sm);
}

.settings.is-hc .btn--primary {
  color: var(--mhp-hc-bg);
}

/* caption tier */
.result {
  display: block;
  margin-top: var(--mhp-space-4);
  font-size: calc(24rpx * var(--mhp-scale));
  line-height: var(--mhp-lh-caption);
  color: var(--text-caption);
  word-break: break-all;
}
