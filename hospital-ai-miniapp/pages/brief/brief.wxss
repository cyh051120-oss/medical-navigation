/* pages/brief/brief.wxss — 就医摘要（任务 20）。
   任务 41：只消费 styles/tokens.wxss；字号四档统一；空/错误/加载态复用 app.wxss 共享类。 */

.brief {
  min-height: 100%;
  box-sizing: border-box;
  padding: var(--mhp-space-6) var(--mhp-space-7) var(--mhp-space-12);
  background: var(--bg-main);
  color: var(--text-body);
}

/* page title tier */
.hero {
  padding: var(--mhp-space-4) var(--mhp-space-2) var(--mhp-space-6);
}

.hero__title {
  display: block;
  font-size: calc(44rpx * var(--mhp-scale));
  line-height: var(--mhp-lh-title);
  font-weight: var(--mhp-fw-semibold);
  color: var(--text-title);
}

/* caption tier */
.hero__sub {
  display: block;
  margin-top: var(--mhp-space-3);
  font-size: calc(24rpx * var(--mhp-scale));
  line-height: var(--mhp-lh-caption);
  color: var(--text-caption);
}

/* ----- 选择区 ----- */

.select {
  padding: var(--mhp-space-7) var(--mhp-space-7) var(--mhp-space-7);
  margin-bottom: var(--mhp-space-7);
  border-radius: var(--radius-lg);
  background: var(--bg-card);
  box-shadow: var(--shadow-md);
}

.select__head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: var(--mhp-space-4);
}

/* section title tier */
.select__title {
  font-size: calc(32rpx * var(--mhp-scale));
  line-height: var(--mhp-lh-title);
  font-weight: var(--mhp-fw-semibold);
  color: var(--text-title);
}

/* caption tier */
.select__count {
  font-size: calc(24rpx * var(--mhp-scale));
  line-height: var(--mhp-lh-caption);
  color: var(--color-primary);
}

.select__tools {
  display: flex;
  gap: var(--mhp-space-4);
  margin: var(--mhp-space-5) 0 var(--mhp-space-5);
}

.profile {
  display: flex;
  flex-direction: column;
  gap: var(--mhp-space-2);
  padding: var(--mhp-space-5) var(--mhp-space-5);
  border-radius: var(--radius-md);
  background: var(--bg-main);
}

.profile__tag {
  font-size: calc(24rpx * var(--mhp-scale));
  line-height: var(--mhp-lh-caption);
  font-weight: var(--mhp-fw-semibold);
  color: var(--color-primary);
}

.profile__text {
  font-size: calc(24rpx * var(--mhp-scale));
  line-height: var(--mhp-lh-caption);
  color: var(--text-caption);
}

.profile__empty {
  display: block;
  font-size: calc(24rpx * var(--mhp-scale));
  line-height: var(--mhp-lh-caption);
  color: var(--text-caption);
}

.group {
  margin-top: var(--mhp-space-6);
}

/* body tier · emphasis (sub-heading) */
.group__title {
  display: block;
  margin-bottom: var(--mhp-space-3);
  font-size: calc(28rpx * var(--mhp-scale));
  line-height: var(--mhp-lh-body);
  font-weight: var(--mhp-fw-semibold);
  color: var(--text-body);
}

.group__empty {
  display: block;
  font-size: calc(24rpx * var(--mhp-scale));
  line-height: var(--mhp-lh-caption);
  color: var(--text-caption);
}

.row {
  display: flex;
  align-items: flex-start;
  gap: var(--mhp-space-5);
  padding: var(--mhp-space-5) var(--mhp-space-5);
  margin-bottom: var(--mhp-space-3);
  border-radius: var(--radius-md);
  background: var(--bg-main);
  transition: background-color var(--motion-fast) var(--ease-standard);
}

.row.is-on {
  background: var(--bg-card);
  box-shadow: var(--shadow-sm);
}

.row__check {
  position: relative;
  flex: none;
  width: 40rpx;
  height: 40rpx;
  box-sizing: border-box;
  margin-top: var(--mhp-space-1);
  border: 3rpx solid var(--text-caption);
  border-radius: var(--radius-xs);
  transition: background-color var(--motion-fast) var(--ease-standard), border-color var(--motion-fast) var(--ease-standard);
}

.row__check.is-on {
  border-color: var(--color-primary);
  background: var(--color-primary);
}

.row__check.is-on::after {
  content: '';
  position: absolute;
  left: 12rpx;
  top: 5rpx;
  width: 10rpx;
  height: 20rpx;
  border-right: 4rpx solid var(--bg-card);
  border-bottom: 4rpx solid var(--bg-card);
  transform: rotate(45deg);
}

.row__body {
  flex: 1;
  min-width: 0;
}

/* body tier */
.row__title {
  display: block;
  font-size: calc(28rpx * var(--mhp-scale));
  line-height: var(--mhp-lh-body);
  color: var(--text-body);
  word-break: break-all;
}

.row__meta {
  display: block;
  margin-top: var(--mhp-space-2);
  font-size: calc(24rpx * var(--mhp-scale));
  line-height: var(--mhp-lh-caption);
  color: var(--text-caption);
  word-break: break-all;
}

/* ----- 生成 / 提示 ----- */

.generate {
  margin: var(--mhp-space-2) 0 var(--mhp-space-2);
}

.generate .btn {
  width: 100%;
  box-sizing: border-box;
}

/* caption tier */
.notice {
  display: block;
  margin-top: var(--mhp-space-4);
  font-size: calc(24rpx * var(--mhp-scale));
  line-height: var(--mhp-lh-caption);
}

.notice--ok {
  color: var(--color-primary);
}

/* ----- 编辑区 ----- */

.editor {
  padding: var(--mhp-space-7) var(--mhp-space-8) var(--mhp-space-8);
  margin-top: var(--mhp-space-7);
  border-radius: var(--radius-lg);
  background: var(--bg-card);
  box-shadow: var(--shadow-md);
}

/* section title tier */
.editor__title {
  display: block;
  font-size: calc(32rpx * var(--mhp-scale));
  line-height: var(--mhp-lh-title);
  font-weight: var(--mhp-fw-semibold);
  color: var(--text-title);
}

.editor__notice {
  display: block;
  margin-top: var(--mhp-space-3);
  font-size: calc(24rpx * var(--mhp-scale));
  line-height: var(--mhp-lh-caption);
  color: var(--text-caption);
}

/* body tier */
.editor__area {
  box-sizing: border-box;
  width: 100%;
  min-height: 420rpx;
  padding: var(--mhp-space-5) var(--mhp-space-6);
  margin-top: var(--mhp-space-6);
  border-radius: var(--radius-sm);
  font-size: calc(28rpx * var(--mhp-scale));
  line-height: var(--mhp-lh-body);
  color: var(--text-body);
  background: var(--bg-main);
}

.editor__actions {
  display: flex;
  gap: var(--mhp-space-5);
  margin-top: var(--mhp-space-6);
}

.editor__actions .btn {
  flex: 1;
}

.editor__saved {
  display: block;
  margin-top: var(--mhp-space-5);
  font-size: calc(24rpx * var(--mhp-scale));
  line-height: var(--mhp-lh-caption);
  color: var(--text-caption);
}

/* ----- 图片导出（任务 21） ----- */

.poster {
  padding: var(--mhp-space-7) var(--mhp-space-8) var(--mhp-space-8);
  margin-top: var(--mhp-space-7);
  border-radius: var(--radius-lg);
  background: var(--bg-card);
  box-shadow: var(--shadow-md);
}

/* section title tier */
.poster__title {
  display: block;
  font-size: calc(32rpx * var(--mhp-scale));
  line-height: var(--mhp-lh-title);
  font-weight: var(--mhp-fw-semibold);
  color: var(--text-title);
}

.poster__notice {
  display: block;
  margin-top: var(--mhp-space-3);
  font-size: calc(24rpx * var(--mhp-scale));
  line-height: var(--mhp-lh-caption);
  color: var(--text-caption);
}

.poster__actions {
  display: flex;
  flex-wrap: wrap;
  gap: var(--mhp-space-4);
  margin-top: var(--mhp-space-6);
}

.poster__actions .btn {
  flex: 1;
  min-width: 210rpx;
}

.poster__share {
  margin: 0;
  line-height: var(--mhp-lh-caption);
}

.poster__share::after {
  border: none;
}

.poster__preview {
  display: block;
  width: 100%;
  margin-top: var(--mhp-space-6);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-sm);
}

.poster__canvas {
  position: fixed;
  left: -2000rpx;
  top: 0;
  width: 750rpx;
  height: 1334rpx;
}

/* ----- 通用按钮 ----- */

/* body tier */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: var(--mhp-space-5) var(--mhp-space-8);
  border-radius: var(--radius-md);
  text-align: center;
  font-size: calc(28rpx * var(--mhp-scale));
  line-height: var(--mhp-lh-body);
  font-weight: var(--mhp-fw-semibold);
}

.btn--primary {
  color: var(--bg-card);
  background: var(--color-primary);
  box-shadow: var(--shadow-neon);
}

/* caption tier */
.btn--ghost {
  padding: var(--mhp-space-4) var(--mhp-space-7);
  font-size: calc(24rpx * var(--mhp-scale));
  line-height: var(--mhp-lh-caption);
  color: var(--color-primary);
  background: var(--bg-card);
  box-shadow: var(--shadow-sm);
}

.brief.is-hc .btn--primary {
  color: var(--mhp-hc-bg);
}
