<!-- pages/brief/brief.wxml — 就医摘要（任务 20）。
     无障碍：根节点内联 --mhp-scale 与 is-hc，消费任务 16 的全局缩放/高对比机制。
     区分「用户原话/整理内容/待医生确认」由编辑区说明行承担（文案来自 config/texts.ts）。 -->
<view class="brief app-shell {{highContrast ? 'is-hc' : ''}} {{sidebarCollapsed ? 'is-collapsed' : ''}}" style="--mhp-scale: {{scale}}">
  <app-sidebar current="brief" collapsed="{{sidebarCollapsed}}" scale="{{scale}}" bind:toggle="onSidebarToggle" />
  <view class="hero">
    <text class="hero__title">{{copy.title}}</text>
    <text class="hero__sub">{{copy.intro}}</text>
  </view>

  <view class="select" wx:if="{{hasSourceRecords || profileAvailable}}">
    <view class="select__head">
      <text class="select__title">{{copy.selectionTitle}}</text>
      <text class="select__count">{{copy.selectedPrefix}} {{selectedCount}} {{copy.selectedUnit}}</text>
    </view>
    <view class="select__tools">
      <view class="btn btn--ghost" bindtap="onSelectAll">{{copy.selectAll}}</view>
      <view class="btn btn--ghost" bindtap="onClearSelection">{{copy.clearSelection}}</view>
    </view>

    <view class="profile" wx:if="{{profileAvailable}}">
      <text class="profile__tag">{{copy.profileTitle}}</text>
      <text class="profile__text">{{copy.profileIncluded}}</text>
    </view>
    <text class="profile__empty" wx:else>{{copy.profileEmpty}}</text>

    <view class="group">
      <text class="group__title">{{copy.symptomsGroup}}</text>
      <view
        class="row {{item.selected ? 'is-on' : ''}}"
        wx:for="{{symptomRows}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="onToggleSymptom"
      >
        <view class="row__check {{item.selected ? 'is-on' : ''}}"></view>
        <view class="row__body">
          <text class="row__title">{{item.title}}</text>
          <text class="row__meta">{{item.meta}}</text>
        </view>
      </view>
      <text class="group__empty" wx:if="{{symptomRows.length === 0}}">{{copy.noSymptoms}}</text>
    </view>

    <view class="group">
      <text class="group__title">{{copy.notesGroup}}</text>
      <view
        class="row {{item.selected ? 'is-on' : ''}}"
        wx:for="{{noteRows}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="onToggleNote"
      >
        <view class="row__check {{item.selected ? 'is-on' : ''}}"></view>
        <view class="row__body">
          <text class="row__title">{{item.title}}</text>
          <text class="row__meta">{{item.meta}}</text>
        </view>
      </view>
      <text class="group__empty" wx:if="{{noteRows.length === 0}}">{{copy.noNotes}}</text>
    </view>

    <view class="group">
      <text class="group__title">{{copy.questionsGroup}}</text>
      <view
        class="row {{item.selected ? 'is-on' : ''}}"
        wx:for="{{questionRows}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="onToggleQuestion"
      >
        <view class="row__check {{item.selected ? 'is-on' : ''}}"></view>
        <view class="row__body">
          <text class="row__title">{{item.title}}</text>
          <text class="row__meta">{{item.meta}}</text>
        </view>
      </view>
      <text class="group__empty" wx:if="{{questionRows.length === 0}}">{{copy.noQuestions}}</text>
    </view>
  </view>

  <view class="mhp-empty" wx:else>
    <view class="mhp-empty__badge"><view class="mhp-ico mhp-ico--clipboard-list"></view></view>
    <text class="mhp-empty__text">{{emptyText}}</text>
  </view>

  <view class="generate">
    <view class="btn btn--primary" bindtap="onGenerate">{{copy.generate}}</view>
  </view>

  <text class="notice mhp-error" wx:if="{{errorText}}">{{errorText}}</text>
  <text class="notice notice--ok" wx:if="{{hint}}">{{hint}}</text>

  <view class="editor">
    <text class="editor__title">{{copy.editorTitle}}</text>
    <text class="editor__notice">{{copy.editorRawNotice}}</text>
    <text class="editor__notice">{{copy.editorOrganizedNotice}}</text>
    <textarea
      class="editor__area"
      value="{{content}}"
      placeholder="{{copy.editorPlaceholder}}"
      bindinput="onContentInput"
      maxlength="-1"
    />
    <view class="editor__actions">
      <view class="btn btn--primary" bindtap="onSave">{{buttons.save}}</view>
      <view class="btn btn--ghost" bindtap="onCopy">{{buttons.copy}}</view>
    </view>
    <text class="editor__saved" wx:if="{{savedAt}}">{{copy.savedAtPrefix}}：{{savedAt}}</text>
  </view>

  <view class="poster">
    <text class="poster__title">{{poster.exportTitle}}</text>
    <text class="poster__notice">{{poster.exportNotice}}</text>
    <view class="mhp-loading" wx:if="{{exporting}}">
      <view class="mhp-loading__spinner"></view>
      <text class="mhp-loading__text">{{poster.exporting}}</text>
    </view>
    <view class="poster__actions">
      <view class="btn btn--primary" bindtap="onExportImage">{{poster.exportImage}}</view>
      <view class="btn btn--ghost" wx:if="{{previewPath}}" bindtap="onSaveImage">{{poster.saveImage}}</view>
      <button class="btn btn--ghost poster__share" open-type="share" wx:if="{{previewPath}}">{{poster.share}}</button>
    </view>
    <image class="poster__preview" wx:if="{{previewPath}}" src="{{previewPath}}" mode="widthFix" />
  </view>

  <canvas type="2d" id="briefPoster" class="poster__canvas"></canvas>
</view>
