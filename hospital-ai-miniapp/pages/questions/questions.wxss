/* pages/questions/questions.wxss — 待问清单（任务 19）。
   任务 41：只消费 styles/tokens.wxss；字号四档统一；空/错误态复用 app.wxss 共享类。 */

.questions {
  min-height: 100%;
  box-sizing: border-box;
  padding: var(--mhp-space-6) var(--mhp-space-7) var(--mhp-space-12);
  background: var(--bg-main);
  color: var(--text-body);
}

.hero {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: var(--mhp-space-5);
  padding: var(--mhp-space-4) var(--mhp-space-2) var(--mhp-space-6);
}

.hero__text {
  flex: 1;
  min-width: 0;
}

/* page title tier */
.hero__title {
  display: block;
  font-size: calc(44rpx * var(--mhp-scale));
  line-height: var(--mhp-lh-title);
  font-weight: var(--mhp-fw-semibold);
  color: var(--text-title);
}

/* caption tier */
.hero__sub {
  display: block;
  margin-top: var(--mhp-space-3);
  font-size: calc(24rpx * var(--mhp-scale));
  line-height: var(--mhp-lh-caption);
  color: var(--text-caption);
}

/* body tier */
.hero__add {
  flex: none;
  padding: var(--mhp-space-4) var(--mhp-space-8);
  border-radius: var(--radius-xl);
  font-size: calc(28rpx * var(--mhp-scale));
  line-height: var(--mhp-lh-body);
  font-weight: var(--mhp-fw-semibold);
  color: var(--bg-card);
  background: var(--color-primary);
  box-shadow: var(--shadow-neon);
}

/* ----- 进度与分组统计 ----- */

.progress {
  display: flex;
  gap: var(--mhp-space-5);
  margin-bottom: var(--mhp-space-5);
}

.progress__item {
  flex: 1;
  padding: var(--mhp-space-6) var(--mhp-space-6);
  border-radius: var(--radius-md);
  background: var(--bg-card);
  box-shadow: var(--shadow-sm);
}

/* display value (not a text tier) */
.progress__value {
  display: block;
  font-size: calc(40rpx * var(--mhp-scale));
  line-height: var(--mhp-lh-title);
  font-weight: var(--mhp-fw-semibold);
  color: var(--color-primary);
}

/* caption tier */
.progress__label {
  display: block;
  margin-top: var(--mhp-space-2);
  font-size: calc(24rpx * var(--mhp-scale));
  line-height: var(--mhp-lh-caption);
  color: var(--text-caption);
}

.stats {
  padding: var(--mhp-space-5) var(--mhp-space-6);
  margin-bottom: var(--mhp-space-5);
  border-radius: var(--radius-md);
  background: var(--bg-card);
  box-shadow: var(--shadow-sm);
}

.stats__title {
  display: block;
  margin-bottom: var(--mhp-space-3);
  font-size: calc(24rpx * var(--mhp-scale));
  line-height: var(--mhp-lh-caption);
  color: var(--text-caption);
}

.stats__list {
  display: flex;
  flex-wrap: wrap;
  gap: var(--mhp-space-3);
}

.chip {
  display: inline-flex;
  align-items: center;
  gap: var(--mhp-space-3);
  padding: var(--mhp-space-3) var(--mhp-space-5);
  border-radius: var(--radius-xl);
  background: var(--bg-main);
}

.chip__name {
  font-size: calc(24rpx * var(--mhp-scale));
  line-height: var(--mhp-lh-caption);
  color: var(--text-body);
}

.chip__count {
  font-size: calc(24rpx * var(--mhp-scale));
  line-height: var(--mhp-lh-caption);
  font-weight: var(--mhp-fw-semibold);
  color: var(--color-primary);
}

.chip--pick {
  padding: 0;
  background: transparent;
}

.chip__pick {
  padding: var(--mhp-space-3) var(--mhp-space-5);
  border-radius: var(--radius-xl);
  font-size: calc(24rpx * var(--mhp-scale));
  line-height: var(--mhp-lh-caption);
  color: var(--color-primary);
  background: var(--bg-main);
}

/* ----- 工具栏 ----- */

.toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--mhp-space-4);
  margin-bottom: var(--mhp-space-5);
}

.toolbar__filter {
  flex: 1;
  min-width: 0;
}

/* caption tier */
.toolbar__toggle {
  flex: none;
  padding: var(--mhp-space-4) var(--mhp-space-7);
  border-radius: var(--radius-md);
  font-size: calc(24rpx * var(--mhp-scale));
  line-height: var(--mhp-lh-caption);
  font-weight: var(--mhp-fw-semibold);
  color: var(--color-primary);
  background: var(--bg-card);
  box-shadow: var(--shadow-sm);
}

/* body tier */
.picker {
  display: block;
  box-sizing: border-box;
  width: 100%;
  padding: var(--mhp-space-5) var(--mhp-space-6);
  border-radius: var(--radius-sm);
  font-size: calc(28rpx * var(--mhp-scale));
  line-height: var(--mhp-lh-body);
  color: var(--text-body);
  background: var(--bg-card);
  box-shadow: var(--shadow-sm);
}

/* ----- 一键导入 ----- */

.import {
  padding: var(--mhp-space-7) var(--mhp-space-7) var(--mhp-space-7);
  margin-bottom: var(--mhp-space-7);
  border-radius: var(--radius-lg);
  background: var(--bg-card);
  box-shadow: var(--shadow-md);
}

/* section title tier */
.import__title {
  display: block;
  font-size: calc(32rpx * var(--mhp-scale));
  line-height: var(--mhp-lh-title);
  font-weight: var(--mhp-fw-semibold);
  color: var(--text-title);
}

.import__intro {
  display: block;
  margin-top: var(--mhp-space-3);
  font-size: calc(24rpx * var(--mhp-scale));
  line-height: var(--mhp-lh-caption);
  color: var(--text-caption);
}

.import__hint {
  display: block;
  margin-top: var(--mhp-space-5);
  font-size: calc(24rpx * var(--mhp-scale));
  line-height: var(--mhp-lh-caption);
  color: var(--color-primary);
}

.import__actions {
  display: flex;
  gap: var(--mhp-space-5);
  margin-top: var(--mhp-space-6);
}

.import__actions .btn {
  flex: 1;
}

/* ----- 表单 ----- */

.editor {
  padding: var(--mhp-space-7) var(--mhp-space-8) var(--mhp-space-8);
  margin-bottom: var(--mhp-space-8);
  border-radius: var(--radius-lg);
  background: var(--bg-card);
  box-shadow: var(--shadow-md);
}

.editor__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--mhp-space-4);
}

/* section title tier */
.editor__title {
  font-size: calc(32rpx * var(--mhp-scale));
  line-height: var(--mhp-lh-title);
  font-weight: var(--mhp-fw-semibold);
  color: var(--text-title);
}

/* caption tier */
.editor__close {
  flex: none;
  padding: var(--mhp-space-2) var(--mhp-space-4);
  font-size: calc(24rpx * var(--mhp-scale));
  line-height: var(--mhp-lh-caption);
  color: var(--text-caption);
}

.field {
  margin-top: var(--mhp-space-6);
}

/* caption tier */
.field__label {
  display: block;
  margin-bottom: var(--mhp-space-3);
  font-size: calc(24rpx * var(--mhp-scale));
  line-height: var(--mhp-lh-caption);
  color: var(--text-caption);
}

.field__hint {
  display: block;
  margin: var(--mhp-space-3) 0 var(--mhp-space-2);
  font-size: calc(24rpx * var(--mhp-scale));
  line-height: var(--mhp-lh-caption);
  color: var(--text-caption);
}

/* body tier */
.field__input,
.field__area {
  box-sizing: border-box;
  width: 100%;
  padding: var(--mhp-space-5) var(--mhp-space-6);
  border-radius: var(--radius-sm);
  font-size: calc(28rpx * var(--mhp-scale));
  line-height: var(--mhp-lh-body);
  color: var(--text-body);
  background: var(--bg-main);
}

.field__area {
  min-height: 180rpx;
  line-height: var(--mhp-lh-body);
}

.chips {
  margin-top: var(--mhp-space-2);
}

.chips .chip {
  margin: 0 var(--mhp-space-3) var(--mhp-space-3) 0;
}

.editor__actions {
  display: flex;
  gap: var(--mhp-space-5);
  margin-top: var(--mhp-space-7);
}

.editor__actions .btn {
  flex: 1;
}

/* ----- 列表 ----- */

.list {
  padding-top: var(--mhp-space-2);
}

.q {
  padding: var(--mhp-space-6) var(--mhp-space-7);
  margin-bottom: var(--mhp-space-6);
  border-radius: var(--radius-md);
  background: var(--bg-card);
  box-shadow: var(--shadow-sm);
}

.q__main {
  display: flex;
  align-items: flex-start;
  gap: var(--mhp-space-5);
}

.q__check {
  position: relative;
  flex: none;
  width: 44rpx;
  height: 44rpx;
  box-sizing: border-box;
  margin-top: var(--mhp-space-1);
  border: 3rpx solid var(--text-caption);
  border-radius: var(--radius-xs);
  transition: background-color var(--motion-fast) var(--ease-standard), border-color var(--motion-fast) var(--ease-standard);
}

.q__check.is-done {
  border-color: var(--color-primary);
  background: var(--color-primary);
}

.q__check.is-done::after {
  content: '';
  position: absolute;
  left: 13rpx;
  top: 6rpx;
  width: 12rpx;
  height: 22rpx;
  border-right: 4rpx solid var(--bg-card);
  border-bottom: 4rpx solid var(--bg-card);
  transform: rotate(45deg);
}

.q__body {
  flex: 1;
  min-width: 0;
}

/* body tier */
.q__text {
  display: block;
  font-size: calc(28rpx * var(--mhp-scale));
  line-height: var(--mhp-lh-body);
  color: var(--text-body);
  word-break: break-all;
}

.q.is-done .q__text {
  color: var(--text-caption);
  text-decoration: line-through;
}

.q__meta {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: var(--mhp-space-3) var(--mhp-space-5);
  margin-top: var(--mhp-space-3);
}

/* caption tier */
.q__group {
  padding: var(--mhp-space-2) var(--mhp-space-4);
  border-radius: var(--radius-xl);
  font-size: calc(24rpx * var(--mhp-scale));
  line-height: var(--mhp-lh-caption);
  color: var(--color-primary);
  background: var(--bg-main);
}

.q__source {
  font-size: calc(24rpx * var(--mhp-scale));
  line-height: var(--mhp-lh-caption);
  color: var(--text-caption);
}

.q__stamp {
  display: flex;
  flex-wrap: wrap;
  gap: var(--mhp-space-2) var(--mhp-space-5);
  margin-top: var(--mhp-space-4);
}

.q__stamp-item {
  font-size: calc(24rpx * var(--mhp-scale));
  line-height: var(--mhp-lh-caption);
  color: var(--text-caption);
}

.q__actions {
  display: flex;
  justify-content: flex-end;
  gap: var(--mhp-space-4);
  margin-top: var(--mhp-space-5);
}

/* ----- 通用按钮 ----- */

/* body tier */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: var(--mhp-space-5) var(--mhp-space-8);
  border-radius: var(--radius-md);
  text-align: center;
  font-size: calc(28rpx * var(--mhp-scale));
  line-height: var(--mhp-lh-body);
  font-weight: var(--mhp-fw-semibold);
}

.btn--primary {
  color: var(--bg-card);
  background: var(--color-primary);
  box-shadow: var(--shadow-neon);
}

/* caption tier */
.btn--ghost {
  padding: var(--mhp-space-4) var(--mhp-space-7);
  font-size: calc(24rpx * var(--mhp-scale));
  line-height: var(--mhp-lh-caption);
  color: var(--color-primary);
  background: var(--bg-card);
  box-shadow: var(--shadow-sm);
}

.btn--danger {
  padding: var(--mhp-space-4) var(--mhp-space-7);
  font-size: calc(24rpx * var(--mhp-scale));
  line-height: var(--mhp-lh-caption);
  color: var(--color-danger);
  background: var(--bg-card);
  border: 2rpx solid var(--color-danger);
}

.questions.is-hc .btn--primary {
  color: var(--mhp-hc-bg);
}
