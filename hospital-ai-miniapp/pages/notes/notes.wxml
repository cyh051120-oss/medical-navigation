<!-- pages/notes/notes.wxml — 资料摘录（任务 18）。
     无障碍：根节点内联 --mhp-scale 与 is-hc，消费任务 16 的全局缩放/高对比机制。 -->
<view class="notes app-shell {{highContrast ? 'is-hc' : ''}} {{sidebarCollapsed ? 'is-collapsed' : ''}}" style="--mhp-scale: {{scale}}">
  <app-sidebar current="notes" collapsed="{{sidebarCollapsed}}" scale="{{scale}}" bind:toggle="onSidebarToggle" />
  <view class="hero">
    <view class="hero__text">
      <text class="hero__title">{{copy.title}}</text>
      <text class="hero__sub">{{copy.intro}}</text>
    </view>
    <view class="hero__add" wx:if="{{!formOpen}}" bindtap="onAdd">{{buttons.add}}</view>
  </view>

  <view class="editor" wx:if="{{formOpen}}">
    <view class="editor__head">
      <text class="editor__title">{{editingId ? copy.editTitle : copy.addTitle}}</text>
      <view class="editor__close" bindtap="onCancelForm">{{buttons.cancel}}</view>
    </view>

    <view class="field">
      <text class="field__label">{{copy.nameLabel}}</text>
      <input
        class="field__input"
        value="{{form.name}}"
        placeholder="{{copy.namePlaceholder}}"
        bindinput="onNameInput"
        maxlength="60"
      />
    </view>

    <view class="field">
      <text class="field__label">{{copy.excerptLabel}}</text>
      <textarea
        class="field__area"
        value="{{form.excerpt}}"
        placeholder="{{copy.excerptPlaceholder}}"
        bindinput="onExcerptInput"
        maxlength="1000"
      />
    </view>

    <view class="field">
      <text class="field__label">{{copy.sourceDateLabel}}</text>
      <picker mode="date" value="{{form.sourceDate}}" bindchange="onSourceDateChange">
        <view class="picker">{{form.sourceDate || copy.sourceDatePlaceholder}}</view>
      </picker>
    </view>

    <view class="field">
      <text class="field__label">{{copy.remarkLabel}}</text>
      <input
        class="field__input"
        value="{{form.remark}}"
        placeholder="{{copy.remarkPlaceholder}}"
        bindinput="onRemarkInput"
        maxlength="200"
      />
    </view>

    <view class="field">
      <text class="field__label">{{copy.attachmentLabel}}</text>
      <view class="attach" wx:if="{{attachmentName}}">
        <text class="attach__name">{{attachmentName}}</text>
        <text class="attach__flag" wx:if="{{existingAttachmentMissing}}">{{copy.attachmentMissing}}</text>
      </view>
      <view class="btn btn--ghost" bindtap="onPickAttachment">
        {{attachmentName ? copy.replaceAttachment : copy.pickAttachment}}
      </view>
      <text class="field__hint">{{copy.attachmentHint}}</text>
    </view>

    <text class="mhp-error" wx:if="{{errorText}}">{{errorText}}</text>

    <view class="editor__actions">
      <view class="btn btn--primary" bindtap="onSave">{{buttons.save}}</view>
      <view class="btn btn--ghost" bindtap="onCancelForm">{{buttons.cancel}}</view>
    </view>
  </view>

  <view class="list" wx:if="{{hasRecords}}">
    <view class="note" wx:for="{{rows}}" wx:key="id">
      <view class="note__head">
        <text class="note__name">{{item.name}}</text>
        <text class="note__date" wx:if="{{item.sourceDate}}">{{copy.sourceDateLabel}} {{item.sourceDate}}</text>
      </view>
      <text class="note__excerpt" wx:if="{{item.excerpt}}">{{item.excerpt}}</text>
      <text class="note__remark" wx:if="{{item.remark}}">{{copy.remarkLabel}}：{{item.remark}}</text>
      <view class="note__attach" wx:if="{{item.hasAttachment}}">
        <view class="note__attach-main">
          <text class="note__attach-label">{{copy.attachmentLabel}}</text>
          <text class="note__attach-name">{{item.attachmentName}}</text>
        </view>
        <text class="note__attach-missing" wx:if="{{item.attachmentMissing}}">{{copy.attachmentMissing}}</text>
        <view
          class="btn btn--ghost note__preview"
          wx:else
          data-id="{{item.id}}"
          bindtap="onPreview"
        >{{copy.preview}}</view>
      </view>
      <view class="note__stamp">
        <text class="note__stamp-item">{{copy.createdAtPrefix}} {{item.createdLabel}}</text>
        <text class="note__stamp-item">{{copy.updatedAtPrefix}} {{item.updatedLabel}}</text>
      </view>
      <view class="note__actions">
        <view class="btn btn--ghost" data-id="{{item.id}}" bindtap="onEdit">{{buttons.edit}}</view>
        <view class="btn btn--danger" data-id="{{item.id}}" bindtap="onDelete">{{buttons.delete}}</view>
      </view>
    </view>
  </view>

  <view class="mhp-empty" wx:else>
    <view class="mhp-empty__badge"><view class="mhp-ico mhp-ico--file-text"></view></view>
    <text class="mhp-empty__text">{{emptyText}}</text>
    <view class="btn btn--primary mhp-empty__action" bindtap="onAdd">{{buttons.add}}</view>
  </view>
</view>
