/* pages/notes/notes.wxss — 资料摘录（任务 18）。
   任务 41：只消费 styles/tokens.wxss；字号四档统一；空/错误态复用 app.wxss 共享类。 */

.notes {
  min-height: 100%;
  box-sizing: border-box;
  padding: var(--mhp-space-6) var(--mhp-space-7) var(--mhp-space-12);
  background: var(--bg-main);
  color: var(--text-body);
}

.hero {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: var(--mhp-space-5);
  padding: var(--mhp-space-4) var(--mhp-space-2) var(--mhp-space-6);
}

.hero__text {
  flex: 1;
  min-width: 0;
}

/* page title tier */
.hero__title {
  display: block;
  font-size: calc(44rpx * var(--mhp-scale));
  line-height: var(--mhp-lh-title);
  font-weight: var(--mhp-fw-semibold);
  color: var(--text-title);
}

/* caption tier */
.hero__sub {
  display: block;
  margin-top: var(--mhp-space-3);
  font-size: calc(24rpx * var(--mhp-scale));
  line-height: var(--mhp-lh-caption);
  color: var(--text-caption);
}

/* body tier */
.hero__add {
  flex: none;
  padding: var(--mhp-space-4) var(--mhp-space-8);
  border-radius: var(--radius-xl);
  font-size: calc(28rpx * var(--mhp-scale));
  line-height: var(--mhp-lh-body);
  font-weight: var(--mhp-fw-semibold);
  color: var(--bg-card);
  background: var(--color-primary);
  box-shadow: var(--shadow-neon);
}

/* ----- 表单 ----- */

.editor {
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-md);
  padding: var(--mhp-space-7) var(--mhp-space-8) var(--mhp-space-8);
  margin-bottom: var(--mhp-space-8);
}

.editor__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--mhp-space-4);
}

/* section title tier */
.editor__title {
  font-size: calc(32rpx * var(--mhp-scale));
  line-height: var(--mhp-lh-title);
  font-weight: var(--mhp-fw-semibold);
  color: var(--text-title);
}

/* caption tier */
.editor__close {
  flex: none;
  padding: var(--mhp-space-2) var(--mhp-space-4);
  font-size: calc(24rpx * var(--mhp-scale));
  line-height: var(--mhp-lh-caption);
  color: var(--text-caption);
}

.field {
  margin-top: var(--mhp-space-6);
}

/* caption tier */
.field__label {
  display: block;
  margin-bottom: var(--mhp-space-3);
  font-size: calc(24rpx * var(--mhp-scale));
  line-height: var(--mhp-lh-caption);
  color: var(--text-caption);
}

.field__hint {
  display: block;
  margin-top: var(--mhp-space-3);
  font-size: calc(24rpx * var(--mhp-scale));
  line-height: var(--mhp-lh-caption);
  color: var(--text-caption);
}

/* body tier */
.field__input,
.field__area,
.picker {
  width: 100%;
  box-sizing: border-box;
  padding: var(--mhp-space-5) var(--mhp-space-6);
  border-radius: var(--radius-sm);
  font-size: calc(28rpx * var(--mhp-scale));
  line-height: var(--mhp-lh-body);
  color: var(--text-body);
  background: var(--bg-main);
}

.field__area {
  min-height: 180rpx;
  line-height: var(--mhp-lh-body);
}

.picker {
  display: block;
  text-align: center;
}

.attach {
  padding: var(--mhp-space-4) var(--mhp-space-6);
  margin-bottom: var(--mhp-space-4);
  border-radius: var(--radius-sm);
  background: var(--bg-main);
}

/* body tier */
.attach__name {
  display: block;
  font-size: calc(28rpx * var(--mhp-scale));
  line-height: var(--mhp-lh-body);
  color: var(--text-body);
  word-break: break-all;
}

/* caption tier */
.attach__flag {
  display: block;
  margin-top: var(--mhp-space-2);
  font-size: calc(24rpx * var(--mhp-scale));
  line-height: var(--mhp-lh-caption);
  color: var(--color-danger);
}

.editor__actions {
  display: flex;
  gap: var(--mhp-space-5);
  margin-top: var(--mhp-space-7);
}

.editor__actions .btn {
  flex: 1;
}

/* ----- 列表 ----- */

.list {
  padding-top: var(--mhp-space-2);
}

.note {
  padding: var(--mhp-space-6) var(--mhp-space-7);
  margin-bottom: var(--mhp-space-6);
  border-radius: var(--radius-md);
  background: var(--bg-card);
  box-shadow: var(--shadow-sm);
}

.note__head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: var(--mhp-space-4);
}

/* section title tier */
.note__name {
  flex: 1;
  min-width: 0;
  font-size: calc(32rpx * var(--mhp-scale));
  line-height: var(--mhp-lh-title);
  font-weight: var(--mhp-fw-semibold);
  color: var(--text-title);
  word-break: break-all;
}

/* caption tier */
.note__date {
  flex: none;
  font-size: calc(24rpx * var(--mhp-scale));
  line-height: var(--mhp-lh-caption);
  color: var(--text-caption);
}

/* body tier */
.note__excerpt {
  display: block;
  margin-top: var(--mhp-space-4);
  font-size: calc(28rpx * var(--mhp-scale));
  line-height: var(--mhp-lh-body);
  color: var(--text-body);
  word-break: break-all;
}

.note__remark {
  display: block;
  margin-top: var(--mhp-space-3);
  font-size: calc(28rpx * var(--mhp-scale));
  line-height: var(--mhp-lh-body);
  color: var(--text-body);
}

.note__attach {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--mhp-space-3);
  margin-top: var(--mhp-space-4);
  padding: var(--mhp-space-3) var(--mhp-space-5);
  border-radius: var(--radius-sm);
  background: var(--bg-main);
}

.note__attach-main {
  flex: 1;
  min-width: 0;
}

.note__attach-label {
  display: block;
  font-size: calc(24rpx * var(--mhp-scale));
  line-height: var(--mhp-lh-caption);
  color: var(--text-caption);
}

.note__attach-name {
  display: block;
  margin-top: var(--mhp-space-1);
  font-size: calc(28rpx * var(--mhp-scale));
  line-height: var(--mhp-lh-body);
  color: var(--text-body);
  word-break: break-all;
}

.note__attach-missing {
  flex: none;
  font-size: calc(24rpx * var(--mhp-scale));
  line-height: var(--mhp-lh-caption);
  color: var(--color-danger);
}

.note__preview {
  flex: none;
}

.note__stamp {
  display: flex;
  flex-wrap: wrap;
  gap: var(--mhp-space-2) var(--mhp-space-5);
  margin-top: var(--mhp-space-4);
}

.note__stamp-item {
  font-size: calc(24rpx * var(--mhp-scale));
  line-height: var(--mhp-lh-caption);
  color: var(--text-caption);
}

.note__actions {
  display: flex;
  justify-content: flex-end;
  gap: var(--mhp-space-4);
  margin-top: var(--mhp-space-5);
}

/* ----- 通用按钮 ----- */

/* body tier */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: var(--mhp-space-5) var(--mhp-space-8);
  border-radius: var(--radius-md);
  text-align: center;
  font-size: calc(28rpx * var(--mhp-scale));
  line-height: var(--mhp-lh-body);
  font-weight: var(--mhp-fw-semibold);
}

.btn--primary {
  color: var(--bg-card);
  background: var(--color-primary);
  box-shadow: var(--shadow-neon);
}

/* caption tier */
.btn--ghost {
  padding: var(--mhp-space-4) var(--mhp-space-7);
  font-size: calc(24rpx * var(--mhp-scale));
  line-height: var(--mhp-lh-caption);
  color: var(--color-primary);
  background: var(--bg-card);
  box-shadow: var(--shadow-sm);
}

.btn--danger {
  padding: var(--mhp-space-4) var(--mhp-space-7);
  font-size: calc(24rpx * var(--mhp-scale));
  line-height: var(--mhp-lh-caption);
  color: var(--color-danger);
  background: var(--bg-card);
  border: 2rpx solid var(--color-danger);
}

.notes.is-hc .btn--primary {
  color: var(--mhp-hc-bg);
}
