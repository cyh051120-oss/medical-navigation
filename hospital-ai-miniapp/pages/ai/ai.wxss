/* pages/ai/ai.wxss — 双模式 AI 助手页（任务 29）。
   任务 41：只消费 styles/tokens.wxss；字号四档统一；空/错误/加载态复用 app.wxss 共享类。
   顶部状态条保留 statusbar--demo 选择器（demo-mode 规范依赖）。 */

.ai {
  min-height: 100%;
  box-sizing: border-box;
  padding: var(--mhp-space-6) var(--mhp-space-7) var(--mhp-space-12);
  background: var(--bg-main);
  color: var(--text-body);
}

/* page title tier */
.hero {
  padding: var(--mhp-space-4) var(--mhp-space-2) var(--mhp-space-5);
}

.hero__title {
  display: block;
  font-size: calc(44rpx * var(--mhp-scale));
  line-height: var(--mhp-lh-title);
  font-weight: var(--mhp-fw-semibold);
  color: var(--text-title);
}

/* caption tier */
.hero__sub {
  display: block;
  margin-top: var(--mhp-space-3);
  font-size: calc(24rpx * var(--mhp-scale));
  line-height: var(--mhp-lh-caption);
  color: var(--text-caption);
}

/* ----- 顶部状态条（任务 31） ----- */

.statusbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--mhp-space-4);
  padding: var(--mhp-space-4) var(--mhp-space-6);
  margin-bottom: var(--mhp-space-5);
  border-radius: var(--radius-md);
  background: var(--bg-card);
  box-shadow: var(--shadow-sm);
  border-left: 6rpx solid var(--text-caption);
}

.statusbar--idle,
.statusbar--ok {
  border-left-color: var(--color-primary);
}

.statusbar--offline,
.statusbar--local {
  border-left-color: var(--color-danger);
}

.statusbar--demo {
  border-left-color: var(--text-title);
}

/* caption tier */
.statusbar__text {
  flex: 1;
  min-width: 0;
  font-size: calc(24rpx * var(--mhp-scale));
  line-height: var(--mhp-lh-caption);
  color: var(--text-body);
}

.statusbar__actions {
  flex: none;
  display: flex;
  gap: var(--mhp-space-4);
}

.statusbar__action {
  font-size: calc(24rpx * var(--mhp-scale));
  line-height: var(--mhp-lh-caption);
  color: var(--color-primary);
  text-decoration: underline;
}

/* ----- 常驻安全提示与免责 ----- */

.safety {
  padding: var(--mhp-space-5) var(--mhp-space-6);
  margin-bottom: var(--mhp-space-5);
  border-radius: var(--radius-md);
  background: var(--bg-card);
  box-shadow: var(--shadow-sm);
}

/* body tier */
.safety__text {
  display: block;
  font-size: calc(28rpx * var(--mhp-scale));
  line-height: var(--mhp-lh-body);
  color: var(--text-body);
}

.safety__text + .safety__text {
  margin-top: var(--mhp-space-3);
  color: var(--text-caption);
}

/* ----- 模式切换 ----- */

.modes {
  display: flex;
  flex-wrap: wrap;
  gap: var(--mhp-space-4);
  margin-bottom: var(--mhp-space-5);
}

.mode {
  flex: 1;
  padding: var(--mhp-space-5) var(--mhp-space-6);
  border-radius: var(--radius-md);
  background: var(--bg-card);
  box-shadow: var(--shadow-sm);
  border: 2rpx solid transparent;
}

.mode.is-active {
  border-color: var(--color-primary);
  box-shadow: var(--shadow-neon);
}

/* section title tier */
.mode__label {
  display: block;
  font-size: calc(32rpx * var(--mhp-scale));
  line-height: var(--mhp-lh-title);
  font-weight: var(--mhp-fw-semibold);
  color: var(--text-title);
}

.mode.is-active .mode__label {
  color: var(--color-primary);
}

/* caption tier */
.mode__hint {
  display: block;
  margin-top: var(--mhp-space-2);
  font-size: calc(24rpx * var(--mhp-scale));
  line-height: var(--mhp-lh-caption);
  color: var(--text-caption);
}

/* ----- 输入区 ----- */

.compose {
  padding: var(--mhp-space-7) var(--mhp-space-7) var(--mhp-space-7);
  margin-bottom: var(--mhp-space-6);
  border-radius: var(--radius-lg);
  background: var(--bg-card);
  box-shadow: var(--shadow-md);
}

/* body tier */
.compose__area {
  box-sizing: border-box;
  width: 100%;
  min-height: 180rpx;
  padding: var(--mhp-space-5) var(--mhp-space-6);
  border-radius: var(--radius-sm);
  font-size: calc(28rpx * var(--mhp-scale));
  line-height: var(--mhp-lh-body);
  color: var(--text-body);
  background: var(--bg-main);
}

.memory {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--mhp-space-4);
  margin-top: var(--mhp-space-4);
}

/* caption tier */
.memory__text {
  font-size: calc(24rpx * var(--mhp-scale));
  line-height: var(--mhp-lh-caption);
  color: var(--color-primary);
}

.memory__jump {
  flex: none;
  font-size: calc(24rpx * var(--mhp-scale));
  line-height: var(--mhp-lh-caption);
  color: var(--text-caption);
  text-decoration: underline;
}

/* ----- 带入资料 ----- */

.context {
  margin-top: var(--mhp-space-6);
  padding-top: var(--mhp-space-6);
  border-top: 2rpx solid var(--bg-main);
}

.context__head {
  margin-bottom: var(--mhp-space-4);
}

/* body tier · emphasis */
.context__title {
  display: block;
  font-size: calc(28rpx * var(--mhp-scale));
  line-height: var(--mhp-lh-body);
  font-weight: var(--mhp-fw-semibold);
  color: var(--text-body);
}

.context__hint {
  display: block;
  margin-top: var(--mhp-space-2);
  font-size: calc(24rpx * var(--mhp-scale));
  line-height: var(--mhp-lh-caption);
  color: var(--text-caption);
}

.toggle {
  padding: var(--mhp-space-4) var(--mhp-space-5);
  margin-bottom: var(--mhp-space-4);
  border-radius: var(--radius-sm);
  background: var(--bg-main);
  border: 2rpx solid transparent;
}

.toggle.is-on {
  border-color: var(--color-primary);
}

.toggle.is-disabled {
  opacity: 0.55;
}

/* body tier */
.toggle__label {
  display: block;
  font-size: calc(28rpx * var(--mhp-scale));
  line-height: var(--mhp-lh-body);
  color: var(--text-body);
}

.toggle__hint {
  display: block;
  margin-top: var(--mhp-space-2);
  font-size: calc(24rpx * var(--mhp-scale));
  line-height: var(--mhp-lh-caption);
  color: var(--text-caption);
}

.candidate {
  display: flex;
  align-items: flex-start;
  gap: var(--mhp-space-4);
  padding: var(--mhp-space-4) var(--mhp-space-5);
  margin-bottom: var(--mhp-space-3);
  border-radius: var(--radius-sm);
  background: var(--bg-main);
  border: 2rpx solid transparent;
}

.candidate.is-on {
  border-color: var(--color-primary);
}

.candidate__check {
  position: relative;
  flex: none;
  width: 36rpx;
  height: 36rpx;
  box-sizing: border-box;
  margin-top: var(--mhp-space-1);
  border: 3rpx solid var(--text-caption);
  border-radius: var(--radius-xs);
}

.candidate__check.is-on {
  border-color: var(--color-primary);
  background: var(--color-primary);
}

.candidate__check.is-on::after {
  content: '';
  position: absolute;
  left: 10rpx;
  top: 4rpx;
  width: 10rpx;
  height: 18rpx;
  border-right: 4rpx solid var(--bg-card);
  border-bottom: 4rpx solid var(--bg-card);
  transform: rotate(45deg);
}

.candidate__body {
  flex: 1;
  min-width: 0;
}

.candidate__kind {
  display: inline-block;
  padding: 2rpx var(--mhp-space-3);
  border-radius: var(--radius-xl);
  font-size: calc(24rpx * var(--mhp-scale));
  line-height: var(--mhp-lh-caption);
  color: var(--color-primary);
  background: var(--bg-card);
}

/* body tier */
.candidate__text {
  display: block;
  margin-top: var(--mhp-space-2);
  font-size: calc(28rpx * var(--mhp-scale));
  line-height: var(--mhp-lh-body);
  color: var(--text-body);
  word-break: break-all;
}

.context__empty {
  display: block;
  font-size: calc(24rpx * var(--mhp-scale));
  line-height: var(--mhp-lh-caption);
  color: var(--text-caption);
}

.compose__hint {
  display: block;
  margin-top: var(--mhp-space-4);
  font-size: calc(24rpx * var(--mhp-scale));
  line-height: var(--mhp-lh-caption);
  color: var(--color-danger);
}

.compose__actions {
  display: flex;
  gap: var(--mhp-space-5);
  margin-top: var(--mhp-space-6);
}

.compose__actions .btn {
  flex: 1;
}

/* ----- 问诊动作条（A 方案）：问答进行中常驻，提供多个本地保存入口。 ----- */
.interview-actions {
  display: flex;
  flex-wrap: wrap;
  gap: var(--mhp-space-5);
  margin-top: var(--mhp-space-5);
}

.interview-actions__btn {
  flex: 1 1 45%;
}

/* ----- 发送前预览 ----- */

.preview {
  padding: var(--mhp-space-7) var(--mhp-space-7) var(--mhp-space-7);
  margin-bottom: var(--mhp-space-6);
  border-radius: var(--radius-lg);
  background: var(--bg-card);
  box-shadow: var(--shadow-md);
  border: 2rpx solid var(--color-primary);
}

/* section title tier */
.preview__title {
  display: block;
  font-size: calc(32rpx * var(--mhp-scale));
  line-height: var(--mhp-lh-title);
  font-weight: var(--mhp-fw-semibold);
  color: var(--color-primary);
}

.preview__intro {
  display: block;
  margin-top: var(--mhp-space-2);
  font-size: calc(24rpx * var(--mhp-scale));
  line-height: var(--mhp-lh-caption);
  color: var(--text-caption);
}

.preview__section {
  margin-top: var(--mhp-space-5);
}

.preview__section-title {
  display: block;
  font-size: calc(24rpx * var(--mhp-scale));
  line-height: var(--mhp-lh-caption);
  font-weight: var(--mhp-fw-semibold);
  color: var(--text-body);
}

.preview__section-text {
  display: block;
  margin-top: var(--mhp-space-2);
  font-size: calc(24rpx * var(--mhp-scale));
  line-height: var(--mhp-lh-caption);
  color: var(--text-body);
  word-break: break-all;
}

.preview__notice {
  display: block;
  margin-top: var(--mhp-space-4);
  font-size: calc(24rpx * var(--mhp-scale));
  line-height: var(--mhp-lh-caption);
  color: var(--color-primary);
}

.preview__actions {
  display: flex;
  gap: var(--mhp-space-5);
  margin-top: var(--mhp-space-6);
}

.preview__actions .btn {
  flex: 1;
}

/* ----- 资料摘录草稿（任务 30） ----- */

.draft {
  padding: var(--mhp-space-7) var(--mhp-space-7) var(--mhp-space-7);
  margin-bottom: var(--mhp-space-6);
  border-radius: var(--radius-lg);
  background: var(--bg-card);
  box-shadow: var(--shadow-md);
  border: 2rpx solid var(--color-primary);
}

/* section title tier */
.draft__title {
  display: block;
  font-size: calc(32rpx * var(--mhp-scale));
  line-height: var(--mhp-lh-title);
  font-weight: var(--mhp-fw-semibold);
  color: var(--color-primary);
}

.draft__intro {
  display: block;
  margin-top: var(--mhp-space-2);
  font-size: calc(24rpx * var(--mhp-scale));
  line-height: var(--mhp-lh-caption);
  color: var(--text-caption);
}

.field {
  margin-top: var(--mhp-space-5);
}

/* caption tier */
.field__label {
  display: block;
  margin-bottom: var(--mhp-space-2);
  font-size: calc(24rpx * var(--mhp-scale));
  line-height: var(--mhp-lh-caption);
  font-weight: var(--mhp-fw-semibold);
  color: var(--text-body);
}

/* body tier */
.field__input,
.field__area {
  box-sizing: border-box;
  width: 100%;
  padding: var(--mhp-space-4) var(--mhp-space-5);
  border-radius: var(--radius-sm);
  font-size: calc(28rpx * var(--mhp-scale));
  line-height: var(--mhp-lh-body);
  color: var(--text-body);
  background: var(--bg-main);
}

.field__area {
  min-height: 160rpx;
}

.draft__hint {
  display: block;
  margin-top: var(--mhp-space-4);
  font-size: calc(24rpx * var(--mhp-scale));
  line-height: var(--mhp-lh-caption);
  color: var(--color-danger);
}

.draft__actions {
  display: flex;
  gap: var(--mhp-space-5);
  margin-top: var(--mhp-space-6);
}

.draft__actions .btn {
  flex: 1;
}

/* ----- 自动记忆提示条 ----- */

.hintbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--mhp-space-4);
  padding: var(--mhp-space-4) var(--mhp-space-6);
  margin-bottom: var(--mhp-space-5);
  border-radius: var(--radius-md);
  background: var(--bg-card);
  box-shadow: var(--shadow-sm);
}

.hintbar__text {
  font-size: calc(24rpx * var(--mhp-scale));
  line-height: var(--mhp-lh-caption);
  color: var(--color-primary);
}

.hintbar__jump {
  flex: none;
  font-size: calc(24rpx * var(--mhp-scale));
  line-height: var(--mhp-lh-caption);
  color: var(--text-caption);
  text-decoration: underline;
}

/* ----- 对话历史 ----- */

.history {
  padding-top: var(--mhp-space-2);
}

.turn {
  padding: var(--mhp-space-6) var(--mhp-space-6);
  margin-bottom: var(--mhp-space-5);
  border-radius: var(--radius-md);
  background: var(--bg-card);
  box-shadow: var(--shadow-sm);
}

.turn--user {
  background: var(--bg-main);
}

/* body tier */
.turn__text {
  display: block;
  font-size: calc(28rpx * var(--mhp-scale));
  line-height: var(--mhp-lh-body);
  color: var(--text-body);
  word-break: break-all;
}

.turn__disclaimer {
  display: block;
  margin-top: var(--mhp-space-4);
  font-size: calc(24rpx * var(--mhp-scale));
  line-height: var(--mhp-lh-caption);
  color: var(--text-caption);
}

.turn__block + .turn__block {
  margin-top: var(--mhp-space-5);
}

.turn__block-title {
  display: block;
  margin-bottom: var(--mhp-space-3);
  font-size: calc(24rpx * var(--mhp-scale));
  line-height: var(--mhp-lh-caption);
  font-weight: var(--mhp-fw-semibold);
  color: var(--color-primary);
}

.item {
  padding: var(--mhp-space-3) 0;
}

.item + .item {
  border-top: 2rpx solid var(--bg-main);
}

.item__head {
  display: flex;
  align-items: flex-start;
  gap: var(--mhp-space-3);
}

/* body tier */
.item__text {
  flex: 1;
  min-width: 0;
  font-size: calc(28rpx * var(--mhp-scale));
  line-height: var(--mhp-lh-body);
  color: var(--text-body);
  word-break: break-all;
}

/* caption tier */
.item__tag {
  flex: none;
  padding: var(--mhp-space-1) var(--mhp-space-4);
  border-radius: var(--radius-xl);
  font-size: calc(24rpx * var(--mhp-scale));
  line-height: var(--mhp-lh-caption);
  color: var(--color-primary);
  background: var(--bg-main);
}

.item__sub {
  display: block;
  margin-top: var(--mhp-space-2);
  font-size: calc(24rpx * var(--mhp-scale));
  line-height: var(--mhp-lh-caption);
  color: var(--text-caption);
  word-break: break-all;
}

.item__actions {
  display: flex;
  flex-wrap: wrap;
  gap: var(--mhp-space-3);
  margin-top: var(--mhp-space-3);
}

.item__action {
  padding: var(--mhp-space-2) var(--mhp-space-5);
  font-size: calc(24rpx * var(--mhp-scale));
  line-height: var(--mhp-lh-caption);
}

.turn__actions {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-end;
  gap: var(--mhp-space-3);
  margin-top: var(--mhp-space-4);
}

/* ----- 通用按钮 ----- */

/* body tier */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: var(--mhp-space-5) var(--mhp-space-8);
  border-radius: var(--radius-md);
  text-align: center;
  font-size: calc(28rpx * var(--mhp-scale));
  line-height: var(--mhp-lh-body);
  font-weight: var(--mhp-fw-semibold);
}

.btn--primary {
  color: var(--bg-card);
  background: var(--color-primary);
  box-shadow: var(--shadow-neon);
}

/* caption tier */
.btn--ghost {
  padding: var(--mhp-space-4) var(--mhp-space-7);
  font-size: calc(24rpx * var(--mhp-scale));
  line-height: var(--mhp-lh-caption);
  color: var(--color-primary);
  background: var(--bg-card);
  box-shadow: var(--shadow-sm);
}

.ai.is-hc .btn--primary {
  color: var(--mhp-hc-bg);
}
