<!-- pages/ai/ai.wxml — 双模式 AI 助手页（任务 29）。
     无障碍：根节点内联 --mhp-scale 与 is-hc，消费任务 16 的全局缩放/高对比机制。 -->
<view class="ai app-shell {{highContrast ? 'is-hc' : ''}} {{sidebarCollapsed ? 'is-collapsed' : ''}}" style="--mhp-scale: {{scale}}; --mhp-layout-scale: {{layoutScale}}">
  <app-sidebar current="ai" collapsed="{{sidebarCollapsed}}" scale="{{scale}}" bind:toggle="onSidebarToggle" />
  <view class="hero">
    <text class="hero__title">{{copy.title}}</text>
    <text class="hero__sub">{{copy.intro}}</text>
  </view>

  <view class="statusbar statusbar--{{aiStatus}}">
    <text class="statusbar__text">{{aiStatusText}}</text>
    <view class="statusbar__actions">
      <text
        class="statusbar__action"
        wx:if="{{aiStatus === 'offline' || aiStatus === 'local'}}"
        bindtap="onRetryConnection"
        aria-role="button"
        aria-label="{{copy.statusRetryAction}}"
      >{{copy.statusRetryAction}}</text>
      <text class="statusbar__action" bindtap="onJumpSettings" aria-role="button" aria-label="{{copy.statusSettingsAction}}">{{copy.statusSettingsAction}}</text>
    </view>
  </view>

  <view class="safety">
    <text class="safety__text">{{safetyFixed}}</text>
    <text class="safety__text">{{notDiagnosis}}</text>
  </view>

  <view class="modes">
    <view
      class="mode {{mode === 'organize' ? 'is-active' : ''}}"
      data-mode="organize"
      bindtap="onSwitchMode"
      aria-role="radio"
      aria-checked="{{mode === 'organize'}}"
      aria-label="{{copy.modeOrganize}}"
    >
      <text class="mode__label">{{copy.modeOrganize}}</text>
      <text class="mode__hint">{{copy.modeOrganizeHint}}</text>
    </view>
    <view
      class="mode {{mode === 'consult' ? 'is-active' : ''}}"
      data-mode="consult"
      bindtap="onSwitchMode"
      aria-role="radio"
      aria-checked="{{mode === 'consult'}}"
      aria-label="{{copy.modeConsult}}"
    >
      <text class="mode__label">{{copy.modeConsult}}</text>
      <text class="mode__hint">{{copy.modeConsultHint}}</text>
    </view>
    <view
      class="mode {{mode === 'interview' ? 'is-active' : ''}}"
      data-mode="interview"
      bindtap="onSwitchMode"
      aria-role="radio"
      aria-checked="{{mode === 'interview'}}"
      aria-label="{{copy.modeInterview}}"
    >
      <text class="mode__label">{{copy.modeInterview}}</text>
      <text class="mode__hint">{{copy.modeInterviewHint}}</text>
    </view>
  </view>

  <view class="compose">
    <textarea
      class="compose__area"
      value="{{input}}"
      placeholder="{{copy.placeholder}}"
      bindinput="onInput"
      maxlength="-1"
    />

    <view class="memory">
      <text class="memory__text">{{memoryLabel}}</text>
      <text class="memory__jump" bindtap="onJumpSettings" aria-role="button" aria-label="{{copy.memoryJump}}">{{copy.memoryJump}}</text>
    </view>

    <view class="context" wx:if="{{mode === 'consult'}}">
      <view class="context__head">
        <text class="context__title">{{copy.includeRecords}}</text>
        <text class="context__hint">{{copy.includeRecordsHint}}</text>
      </view>

      <view
        class="toggle {{includeProfile ? 'is-on' : ''}} {{profileAvailable ? '' : 'is-disabled'}}"
        bindtap="onToggleProfile"
        aria-role="switch"
        aria-checked="{{includeProfile}}"
        aria-label="{{copy.includeProfile}}"
      >
        <text class="toggle__label">{{copy.includeProfile}}</text>
        <text class="toggle__hint" wx:if="{{!profileAvailable}}">{{copy.includeProfileEmpty}}</text>
      </view>

      <view class="candidates" wx:if="{{candidateCount > 0}}">
        <view
          class="candidate {{item.selected ? 'is-on' : ''}}"
          wx:for="{{candidates}}"
          wx:key="id"
          data-id="{{item.id}}"
          bindtap="onToggleExcerpt"
          aria-role="checkbox"
          aria-checked="{{item.selected}}"
          aria-label="{{item.kindLabel}}"
        >
          <view class="candidate__check {{item.selected ? 'is-on' : ''}}"></view>
          <view class="candidate__body">
            <text class="candidate__kind">{{item.kindLabel}}</text>
            <text class="candidate__text">{{item.excerpt}}</text>
          </view>
        </view>
      </view>
      <text class="context__empty" wx:else>{{copy.memoriesAutoHint}}</text>
    </view>

    <text class="compose__hint" wx:if="{{hint}}">{{hint}}</text>

    <view class="interview-actions" wx:if="{{mode === 'interview' && interviewCount > 0}}">
      <view class="btn btn--ghost interview-actions__btn" bindtap="onInterviewSaveSymptom" aria-role="button" aria-label="{{copy.interviewSaveSymptom}}">{{copy.interviewSaveSymptom}}</view>
      <view class="btn btn--ghost interview-actions__btn" bindtap="onInterviewAddQuestions" aria-role="button" aria-label="{{copy.interviewAddQuestions}}">{{copy.interviewAddQuestions}}</view>
      <view class="btn btn--ghost interview-actions__btn" bindtap="onInterviewSaveNote" aria-role="button" aria-label="{{copy.interviewSaveNote}}">{{copy.interviewSaveNote}}</view>
    </view>

    <view class="compose__actions">
      <view class="btn btn--ghost" data-id="input" bindtap="onSaveMemory" aria-role="button" aria-label="{{copy.saveMemory}}">{{copy.saveMemory}}</view>
      <view class="btn btn--primary" bindtap="onSend" aria-role="button" aria-label="{{copy.send}}">{{copy.send}}</view>
    </view>

    <view class="mhp-loading" wx:if="{{sending}}">
      <view class="mhp-loading__spinner"></view>
      <text class="mhp-loading__text">发送中…</text>
    </view>
  </view>

  <view class="preview" wx:if="{{previewOpen}}">
    <text class="preview__title">{{copy.previewTitle}}</text>
    <text class="preview__intro">{{copy.previewIntro}}</text>
    <view class="preview__section" wx:for="{{previewSections}}" wx:key="key">
      <text class="preview__section-title">{{item.title}}</text>
      <text class="preview__section-text">{{item.text}}</text>
    </view>
    <text class="preview__notice" wx:if="{{previewMemoryNotice}}">{{previewMemoryNotice}}</text>
    <text class="preview__notice" wx:if="{{previewDemoNotice}}">{{previewDemoNotice}}</text>
    <view class="preview__actions">
      <view class="btn btn--primary" bindtap="onConfirmSend" aria-role="button" aria-label="{{copy.previewConfirm}}">{{copy.previewConfirm}}</view>
      <view class="btn btn--ghost" bindtap="onCancelPreview" aria-role="button" aria-label="{{copy.previewCancel}}">{{copy.previewCancel}}</view>
    </view>
  </view>

  <view class="draft" wx:if="{{draftOpen}}">
    <text class="draft__title">{{copy.noteDraftTitle}}</text>
    <text class="draft__intro">{{copy.noteDraftIntro}}</text>
    <view class="field">
      <text class="field__label">{{copy.noteDraftNameLabel}}</text>
      <input
        class="field__input"
        value="{{draftForm.name}}"
        data-field="name"
        bindinput="onDraftInput"
        maxlength="60"
      />
    </view>
    <view class="field">
      <text class="field__label">{{copy.noteDraftExcerptLabel}}</text>
      <textarea
        class="field__area"
        value="{{draftForm.excerpt}}"
        data-field="excerpt"
        bindinput="onDraftInput"
        maxlength="-1"
      />
    </view>
    <view class="field">
      <text class="field__label">{{copy.noteDraftRemarkLabel}}</text>
      <input
        class="field__input"
        value="{{draftForm.remark}}"
        data-field="remark"
        bindinput="onDraftInput"
        maxlength="300"
      />
    </view>
    <text class="draft__hint" wx:if="{{draftHint}}">{{draftHint}}</text>
    <view class="draft__actions">
      <view class="btn btn--primary" bindtap="onDraftConfirm" aria-role="button" aria-label="{{copy.noteDraftConfirm}}">{{copy.noteDraftConfirm}}</view>
      <view class="btn btn--ghost" bindtap="onDraftCancel" aria-role="button" aria-label="{{copy.noteDraftCancel}}">{{copy.noteDraftCancel}}</view>
    </view>
  </view>

  <view class="draft" wx:if="{{interviewDraftOpen}}">
    <text class="draft__title">{{copy.interviewDraftTitle}}</text>
    <text class="draft__intro">{{copy.interviewDraftIntro}}</text>
    <view class="field">
      <text class="field__label">{{copy.interviewDraftTextLabel}}</text>
      <textarea
        class="field__area"
        value="{{interviewDraft.text}}"
        data-field="text"
        bindinput="onInterviewDraftInput"
        maxlength="-1"
      />
    </view>
    <view class="field">
      <text class="field__label">{{copy.interviewDraftOnsetLabel}}</text>
      <input
        class="field__input"
        value="{{interviewDraft.occurredAt}}"
        data-field="occurredAt"
        bindinput="onInterviewDraftInput"
        maxlength="40"
      />
    </view>
    <view class="field">
      <text class="field__label">{{copy.interviewDraftDurationLabel}}</text>
      <input
        class="field__input"
        value="{{interviewDraft.duration}}"
        data-field="duration"
        bindinput="onInterviewDraftInput"
        maxlength="40"
      />
    </view>
    <view class="field">
      <text class="field__label">{{copy.interviewDraftImpactLabel}}</text>
      <input
        class="field__input"
        value="{{interviewDraft.impact}}"
        data-field="impact"
        bindinput="onInterviewDraftInput"
        maxlength="60"
      />
    </view>
    <view class="field">
      <text class="field__label">{{copy.interviewDraftTagsLabel}}</text>
      <input
        class="field__input"
        value="{{interviewDraft.tags}}"
        data-field="tags"
        bindinput="onInterviewDraftInput"
        maxlength="60"
      />
    </view>
    <text class="draft__hint" wx:if="{{interviewDraftHint}}">{{interviewDraftHint}}</text>
    <view class="draft__actions">
      <view class="btn btn--primary" bindtap="onInterviewDraftConfirm" aria-role="button" aria-label="{{copy.interviewDraftConfirm}}">{{copy.interviewDraftConfirm}}</view>
      <view class="btn btn--ghost" bindtap="onInterviewDraftCancel" aria-role="button" aria-label="{{copy.interviewDraftCancel}}">{{copy.interviewDraftCancel}}</view>
    </view>
  </view>

  <view class="hintbar" wx:if="{{autoMemoryHint}}">
    <text class="hintbar__text">{{autoMemoryHint}}</text>
    <text class="hintbar__jump" bindtap="onJumpSettings" aria-role="button" aria-label="{{copy.autoMemoryJump}}">{{copy.autoMemoryJump}}</text>
  </view>

  <view class="history" wx:if="{{hasMessages}}">
    <view class="turn turn--{{item.role}}" wx:for="{{messages}}" wx:key="id">
      <view class="turn__block" wx:for="{{item.blocks}}" wx:for-item="block" wx:for-index="bIndex" wx:key="title">
        <text class="turn__block-title">{{block.title}}</text>
        <view class="turn__items">
          <view class="item" wx:for="{{block.items}}" wx:for-item="entry" wx:for-index="eIndex" wx:key="text">
            <view class="item__head">
              <text class="item__text">{{entry.text}}</text>
              <text class="item__tag" wx:if="{{entry.tag}}">{{entry.tag}}</text>
            </view>
            <text class="item__sub" wx:if="{{entry.sub}}">{{entry.sub}}</text>
            <view class="item__actions" wx:if="{{block.note || block.ask}}">
              <view
                class="btn btn--ghost item__action"
                wx:if="{{block.note}}"
                data-message-id="{{item.id}}"
                data-block-index="{{bIndex}}"
                data-item-index="{{eIndex}}"
                bindtap="onSaveAsNote"
                aria-role="button"
                aria-label="{{copy.saveAsNote}}"
              >{{copy.saveAsNote}}</view>
              <view
                class="btn btn--ghost item__action"
                wx:if="{{block.ask}}"
                data-message-id="{{item.id}}"
                data-block-index="{{bIndex}}"
                data-item-index="{{eIndex}}"
                bindtap="onAddToQuestions"
                aria-role="button"
                aria-label="{{copy.addToQuestions}}"
              >{{copy.addToQuestions}}</view>
            </view>
          </view>
        </view>
      </view>
      <text class="turn__text" wx:if="{{item.content}}">{{item.content}}</text>
      <text class="mhp-error" wx:if="{{item.errorText}}">{{item.errorText}}</text>
      <text class="turn__disclaimer" wx:if="{{item.disclaimer}}">{{item.disclaimer}}</text>
      <view class="turn__actions">
        <view
          class="btn btn--ghost"
          wx:if="{{item.kind === 'error' && item.canLocalOrganize}}"
          data-text="{{item.localText}}"
          bindtap="onLocalOrganize"
          aria-role="button"
          aria-label="{{copy.localOrganize}}"
        >{{copy.localOrganize}}</view>
        <view class="btn btn--ghost" wx:if="{{item.memoryDraft}}" data-id="{{item.id}}" bindtap="onSaveMemory" aria-role="button" aria-label="{{copy.saveMemory}}">{{copy.saveMemory}}</view>
      </view>
    </view>
  </view>

  <view class="mhp-empty" wx:else>
    <text class="mhp-empty__text">{{copy.historyEmpty}}</text>
  </view>
</view>
