<!-- 首页是就诊准备的起点：明确下一步行动，常用记录就地进入。共用 controller 与导航契约。 -->
<view class="wb-hero">
  <view class="wb-hero__meta">
    <view class="wb-hero__brand">
      <view class="wb-hero__brand-symbol"><view class="mhp-ico mhp-ico--stethoscope"></view></view>
      <text>就医准备手帐</text>
    </view>
    <text class="wb-hero__date">{{todayLabel}}</text>
  </view>
  <text class="wb-hero__greeting">{{greeting}}{{profileName ? '，' + profileName : ''}}</text>
  <text class="wb-hero__tagline">{{home.tagline}}</text>
</view>

<!-- 初次使用时没有摘要来源，先引导记一条症状；已有记录或有效档案时再提供摘要入口。 -->
<view
  class="wb-next"
  data-route="{{hasRecords || completeness.filled > 0 ? 'pages/brief/brief' : 'pages/symptoms/symptoms'}}"
  bindtap="onEntryTap"
  aria-role="button"
  aria-label="{{hasRecords || completeness.filled > 0 ? '生成就医摘要' : '记一条症状'}}"
>
  <view class="wb-next__ornament"></view>
  <view class="wb-next__art">
    <view class="mhp-ico {{hasRecords || completeness.filled > 0 ? 'mhp-ico--clipboard-list' : 'mhp-ico--stethoscope'}} wb-next__icon"></view>
  </view>
  <view class="wb-next__copy">
    <view class="wb-next__eyebrow"><view class="wb-next__signal"></view><text>{{hasRecords || completeness.filled > 0 ? '准备去看医生？' : '从这里开始'}}</text></view>
    <text class="wb-next__title">{{hasRecords || completeness.filled > 0 ? '生成就医摘要' : '记一条症状'}}</text>
    <text class="wb-next__desc">{{hasRecords || completeness.filled > 0 ? '把症状、资料和待问问题整理成一份清晰的就诊摘要' : '先记录身体感受、发生时间和影响，之后就能整理成就医摘要'}}</text>
    <view class="wb-next__action"><text>{{hasRecords || completeness.filled > 0 ? '开始整理' : '开始记录'}}</text><text>↗</text></view>
  </view>
</view>

<view class="wb-overview">
  <view class="wb-overview__head">
    <text class="wb-overview__title">{{home.profileTitle}}</text>
    <text class="wb-overview__link" bindtap="onProfileTap" aria-role="button" aria-label="{{profileLinkLabel}}">{{profileLinkLabel}}  ›</text>
  </view>
  <view class="wb-overview__metric">
    <text class="wb-overview__value">{{completeness.filled}}</text>
    <text class="wb-overview__total">/ {{completeness.total}}</text>
    <text class="wb-overview__unit">{{home.overviewUnit}}</text>
  </view>
  <view class="wb-overview__bar"><view class="wb-overview__fill" style="width: {{completeness.percent}}%;"></view></view>
  <text class="wb-overview__hint">{{profileHint}}</text>
</view>

<view class="wb-section">
  <view class="wb-section__head">
    <text class="wb-section__title">我的记录</text>
    <text class="wb-section__hint">点按分类继续整理</text>
  </view>
  <view class="wb-stats">
    <view class="wb-stat" data-route="pages/symptoms/symptoms" bindtap="onEntryTap" aria-role="button" aria-label="{{home.statSymptoms}} {{stats.symptoms}} 条">
      <view class="wb-stat__symbol"><view class="mhp-ico mhp-ico--stethoscope wb-stat__ico"></view></view>
      <text class="wb-stat__num">{{stats.symptoms}}</text>
      <text class="wb-stat__label">{{home.statSymptoms}}</text>
    </view>
    <view class="wb-stat" data-route="pages/notes/notes" bindtap="onEntryTap" aria-role="button" aria-label="{{home.statNotes}} {{stats.notes}} 条">
      <view class="wb-stat__symbol"><view class="mhp-ico mhp-ico--file-text wb-stat__ico"></view></view>
      <text class="wb-stat__num">{{stats.notes}}</text>
      <text class="wb-stat__label">{{home.statNotes}}</text>
    </view>
    <view class="wb-stat" data-route="pages/questions/questions" bindtap="onEntryTap" aria-role="button" aria-label="{{home.statQuestions}} {{stats.questions}} 条">
      <view class="wb-stat__symbol"><view class="mhp-ico mhp-ico--message-circle-question wb-stat__ico"></view></view>
      <text class="wb-stat__num">{{stats.questions}}</text>
      <text class="wb-stat__label">{{home.statQuestions}}</text>
    </view>
  </view>
</view>

<view class="wb-section">
  <view class="wb-section__head">
    <text class="wb-section__title">{{home.recentTitle}}</text>
    <text class="wb-section__hint" wx:if="{{hasRecords}}">{{home.recentHint}}</text>
  </view>
  <view class="mhp-empty mhp-empty--inline" wx:if="{{!hasRecords}}">
    <text class="mhp-empty__text">{{emptyRecordsText}}</text>
    <view class="wb-empty__action" data-route="pages/symptoms/symptoms" bindtap="onEntryTap" aria-role="button" aria-label="{{home.emptyAction}}">{{home.emptyAction}}</view>
  </view>
  <view class="wb-list" wx:else>
    <view class="wb-row" wx:for="{{recentRecords}}" wx:key="key" data-route="{{item.route}}" bindtap="onEntryTap" aria-role="button" aria-label="{{item.label}} {{item.summary}}">
      <text class="wb-row__tag">{{item.label}}</text>
      <text class="wb-row__summary">{{item.summary}}</text>
      <text class="wb-row__time">{{item.updatedLabel}}</text>
    </view>
  </view>
</view>

<view class="wb-tips">
  <view class="mhp-ico mhp-ico--info wb-tips__ico"></view>
  <view class="wb-tips__body">
    <text class="wb-tips__title">{{home.tipsTitle}}</text>
    <text class="wb-tips__text">{{safetyFixed}}</text>
    <text class="wb-tips__text wb-tips__text--muted">{{privacyFixed}}</text>
  </view>
</view>
