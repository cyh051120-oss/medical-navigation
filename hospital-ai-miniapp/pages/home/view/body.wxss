/* 视觉语言：暖白工作纸张 + 松绿墨色 + 轻薄荷高频动作。
   与所有业务宿主共享同一组语义令牌；高对比走 app.wxss 映射。 */
.workbench {
  box-sizing: border-box;
  min-height: 100%;
  padding: var(--mhp-space-5) var(--mhp-space-7) var(--mhp-space-11);
  color: var(--text-body);
  background: var(--bg-main);
}
.wb-hero {
  padding: var(--mhp-space-3) var(--mhp-space-2) var(--mhp-space-8);
}
.wb-hero__meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: var(--mhp-space-3);
  margin-bottom: var(--mhp-space-7);
}
.wb-hero__brand {
  display: flex;
  align-items: center;
  gap: var(--mhp-space-3);
  font-size: calc(24rpx * var(--mhp-scale));
  line-height: var(--mhp-lh-caption);
  color: var(--color-primary);
  font-weight: var(--mhp-fw-semibold);
  letter-spacing: 2rpx;
}
.wb-hero__brand-symbol {
  display: flex;
  align-items: center;
  justify-content: center;
  width: calc(38rpx * var(--mhp-layout-scale));
  height: calc(38rpx * var(--mhp-layout-scale));
  border-radius: var(--radius-xs);
  background: var(--color-primary);
  color: var(--color-on-primary);
}
.wb-hero__brand-symbol .mhp-ico {
  width: calc(24rpx * var(--mhp-layout-scale));
  height: calc(24rpx * var(--mhp-layout-scale));
}
.wb-hero__date {
  font-size: calc(23rpx * var(--mhp-scale));
  line-height: var(--mhp-lh-caption);
  color: var(--text-caption);
}
.wb-hero__greeting {
  display: block;
  font-size: calc(48rpx * var(--mhp-scale));
  line-height: var(--mhp-lh-title);
  font-weight: var(--mhp-fw-semibold);
  color: var(--text-title);
  word-break: break-word;
  letter-spacing: -1rpx;
}
.wb-hero__tagline {
  display: block;
  max-width: 620rpx;
  margin-top: var(--mhp-space-4);
  font-size: calc(25rpx * var(--mhp-scale));
  line-height: var(--mhp-lh-body);
  color: var(--text-caption);
}
/* Signature: a single ink-green preparation card, mint action and orbital mark. */
.wb-next {
  position: relative;
  display: flex;
  align-items: flex-start;
  overflow: hidden;
  min-height: 302rpx;
  box-sizing: border-box;
  padding: var(--mhp-space-8);
  border-radius: var(--radius-xl);
  color: var(--color-on-action);
  background: var(--surface-action);
  box-shadow: var(--shadow-md);
}
.wb-next__ornament {
  position: absolute;
  top: -132rpx;
  right: -114rpx;
  width: 370rpx;
  height: 370rpx;
  border-radius: 50%;
  border: 48rpx solid var(--color-primary);
  opacity: 0.42;
}
.wb-next__copy {
  position: relative;
  z-index: 1;
  flex: 1;
  min-width: 0;
}
.wb-next__eyebrow {
  display: flex;
  align-items: center;
  gap: var(--mhp-space-3);
  font-size: calc(23rpx * var(--mhp-scale));
  font-weight: var(--mhp-fw-semibold);
  line-height: var(--mhp-lh-caption);
  color: var(--color-decoration);
}
.wb-next__signal {
  width: 11rpx;
  height: 11rpx;
  border-radius: 50%;
  background: var(--color-decoration);
}
.wb-next__title {
  display: block;
  margin-top: var(--mhp-space-4);
  font-size: calc(39rpx * var(--mhp-scale));
  line-height: var(--mhp-lh-title);
  font-weight: var(--mhp-fw-semibold);
  color: var(--color-on-action);
}
.wb-next__desc {
  display: block;
  margin-top: var(--mhp-space-4);
  max-width: 520rpx;
  font-size: calc(25rpx * var(--mhp-scale));
  line-height: var(--mhp-lh-body);
  color: var(--color-on-action);
  opacity: 0.82;
}
.wb-next__action {
  display: inline-flex;
  align-items: center;
  gap: var(--mhp-space-5);
  margin-top: var(--mhp-space-7);
  padding: var(--mhp-space-3) var(--mhp-space-6);
  border-radius: var(--radius-xl);
  font-size: calc(25rpx * var(--mhp-scale));
  line-height: var(--mhp-lh-body);
  font-weight: var(--mhp-fw-semibold);
  color: var(--surface-action);
  background: var(--color-decoration);
}
.wb-next__art {
  position: absolute;
  z-index: 1;
  right: 30rpx;
  top: 31rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: calc(94rpx * var(--mhp-layout-scale));
  height: calc(94rpx * var(--mhp-layout-scale));
  border: 2rpx solid var(--color-decoration);
  border-radius: var(--radius-xl);
  color: var(--color-decoration);
}
.wb-next__icon {
  width: calc(43rpx * var(--mhp-layout-scale));
  height: calc(43rpx * var(--mhp-layout-scale));
}
/* The hero artwork is decorative; large type needs full text width. */
.workbench.is-large-text .wb-next__art,
.is-large-text .workbench .wb-next__art { opacity: 0.20; }
.wb-overview {
  margin-top: var(--mhp-space-6);
  padding: var(--mhp-space-7) var(--mhp-space-8);
  border: 2rpx solid var(--border-subtle);
  border-radius: var(--radius-lg);
  background: var(--bg-card);
  box-shadow: var(--shadow-sm);
}
.wb-overview__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: var(--mhp-space-3);
}
.wb-overview__title {
  font-size: calc(28rpx * var(--mhp-scale));
  line-height: var(--mhp-lh-body);
  font-weight: var(--mhp-fw-semibold);
  color: var(--text-title);
}
.wb-overview__link {
  display: inline-flex;
  align-items: center;
  min-height: 88rpx;
  font-size: calc(24rpx * var(--mhp-scale));
  line-height: var(--mhp-lh-caption);
  color: var(--color-primary);
}
.wb-overview__metric {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  gap: var(--mhp-space-2);
  margin-top: var(--mhp-space-2);
}
.wb-overview__value {
  font-size: calc(42rpx * var(--mhp-scale));
  line-height: var(--mhp-lh-title);
  font-weight: var(--mhp-fw-semibold);
  color: var(--text-title);
}
.wb-overview__total {
  font-size: calc(29rpx * var(--mhp-scale));
  line-height: var(--mhp-lh-title);
  color: var(--text-caption);
}
.wb-overview__unit {
  margin-left: var(--mhp-space-2);
  font-size: calc(24rpx * var(--mhp-scale));
  color: var(--text-caption);
}
.wb-overview__bar {
  height: 12rpx;
  margin-top: var(--mhp-space-5);
  border-radius: var(--radius-xl);
  overflow: hidden;
  background: var(--bg-accent);
}
.wb-overview__fill {
  height: 100%;
  border-radius: var(--radius-xl);
  background: var(--color-primary);
  transition: width var(--motion-normal) var(--ease-standard);
}
.wb-overview__hint {
  display: block;
  margin-top: var(--mhp-space-4);
  font-size: calc(24rpx * var(--mhp-scale));
  line-height: var(--mhp-lh-caption);
  color: var(--text-caption);
}
.wb-section { margin-top: var(--mhp-space-9); }
.wb-section__head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: var(--mhp-space-2) var(--mhp-space-5);
  margin-bottom: var(--mhp-space-5);
}
.wb-section__title {
  font-size: calc(32rpx * var(--mhp-scale));
  line-height: var(--mhp-lh-title);
  font-weight: var(--mhp-fw-semibold);
  color: var(--text-title);
}
.wb-section__hint {
  font-size: calc(24rpx * var(--mhp-scale));
  line-height: var(--mhp-lh-caption);
  color: var(--text-caption);
}
.wb-stats { display: flex; gap: var(--mhp-space-3); }
.wb-stat {
  flex: 1;
  min-width: 0;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: var(--mhp-space-5) var(--mhp-space-2);
  border-radius: var(--radius-lg);
  background: var(--bg-card);
  border: 2rpx solid var(--border-subtle);
}
.wb-stat__symbol {
  display: flex;
  align-items: center;
  justify-content: center;
  width: calc(58rpx * var(--mhp-layout-scale));
  height: calc(58rpx * var(--mhp-layout-scale));
  border-radius: var(--radius-md);
  background: var(--bg-accent);
  color: var(--color-primary);
}
.wb-stat__ico {
  width: calc(30rpx * var(--mhp-layout-scale));
  height: calc(30rpx * var(--mhp-layout-scale));
}
.wb-stat__num {
  margin-top: var(--mhp-space-3);
  font-size: calc(37rpx * var(--mhp-scale));
  line-height: var(--mhp-lh-title);
  font-weight: var(--mhp-fw-semibold);
  color: var(--text-title);
}
.wb-stat__label {
  margin-top: var(--mhp-space-2);
  font-size: calc(24rpx * var(--mhp-scale));
  line-height: var(--mhp-lh-caption);
  color: var(--text-caption);
  text-align: center;
}
.wb-list {
  border: 2rpx solid var(--border-subtle);
  border-radius: var(--radius-lg);
  background: var(--bg-card);
  overflow: hidden;
}
.wb-row {
  display: flex;
  align-items: flex-start;
  flex-wrap: wrap;
  gap: var(--mhp-space-3) var(--mhp-space-4);
  padding: var(--mhp-space-6) var(--mhp-space-7);
}
.wb-row + .wb-row { border-top: 2rpx solid var(--border-subtle); }
.wb-row__tag {
  flex: none;
  padding: var(--mhp-space-1) var(--mhp-space-3);
  border-radius: var(--radius-xs);
  font-size: calc(24rpx * var(--mhp-scale));
  line-height: var(--mhp-lh-caption);
  color: var(--color-primary);
  background: var(--bg-accent);
}
.wb-row__summary {
  flex: 1;
  min-width: 0;
  font-size: calc(28rpx * var(--mhp-scale));
  line-height: var(--mhp-lh-body);
  color: var(--text-title);
  word-break: break-word;
}
.wb-row__time {
  display: block;
  flex: 1 1 100%;
  font-size: calc(23rpx * var(--mhp-scale));
  line-height: var(--mhp-lh-caption);
  color: var(--text-caption);
}
.wb-empty__action {
  align-self: center;
  min-height: 88rpx;
  display: flex;
  align-items: center;
  padding: var(--mhp-space-2) var(--mhp-space-7);
  border-radius: var(--radius-md);
  background: var(--color-primary);
  font-size: calc(28rpx * var(--mhp-scale));
  color: var(--color-on-primary);
}
.wb-tips {
  display: flex;
  gap: var(--mhp-space-4);
  margin-top: var(--mhp-space-9);
  padding: var(--mhp-space-6);
  border: 2rpx solid var(--border-subtle);
  border-radius: var(--radius-lg);
  background: var(--bg-warm);
}
.wb-tips__ico {
  flex: none;
  width: calc(32rpx * var(--mhp-layout-scale));
  height: calc(32rpx * var(--mhp-layout-scale));
  margin-top: var(--mhp-space-1);
  color: var(--color-warm);
}
.wb-tips__body { flex: 1; min-width: 0; }
.wb-tips__title {
  display: block;
  font-size: calc(26rpx * var(--mhp-scale));
  font-weight: var(--mhp-fw-semibold);
  color: var(--text-title);
}
.wb-tips__text {
  display: block;
  margin-top: var(--mhp-space-2);
  font-size: calc(24rpx * var(--mhp-scale));
  line-height: var(--mhp-lh-caption);
  color: var(--text-body);
}
.wb-tips__text--muted { color: var(--text-caption); }
/* HC must preserve ink-card hierarchy without relying on opacity alone. */
.is-hc .wb-next__action,
.workbench.is-hc .wb-next__action {
  border: 2rpx solid var(--mhp-hc-bg);
  background: var(--mhp-hc-bg);
  color: var(--mhp-hc-accent);
}
.is-hc .wb-next__eyebrow,
.workbench.is-hc .wb-next__eyebrow { color: var(--mhp-hc-bg); }
.is-hc .wb-next__signal,
.workbench.is-hc .wb-next__signal { background: var(--mhp-hc-bg); }
.is-hc .wb-next__art,
.workbench.is-hc .wb-next__art { color: var(--mhp-hc-bg); border-color: var(--mhp-hc-bg); }
