/* components/app-sidebar/app-sidebar.wxss — 全局可折叠左侧导航栏。
   样式隔离 isolated：本文件自带图标类（@import icons.wxss）；颜色/间距令牌
   （--bg-card / --color-primary / --text-* / --mhp-space-*）从页面根节点继承，
   故 .is-hc 高对比会自动生效。宽度与 app.wxss 的 --mhp-sidebar-w 共用同一变量
   --mhp-layout-scale（a11y.ts 写入页面根节点，上限 1.2）：展开 248rpx、收起 96rpx，
   布局宽度不再随 --mhp-scale 线性放大；字号仍全部 calc(Nrpx * var(--mhp-scale))。
   P1-34：收起态仅图标，导航项与开关都带 aria-label；标签允许换行，避免大字档被裁。 */

@import "../../styles/icons.wxss";

.sb {
  position: fixed;
  left: 0;
  top: 0;
  bottom: 0;
  z-index: 50;
  display: flex;
  flex-direction: column;
  width: calc(248rpx * var(--mhp-layout-scale));
  box-sizing: border-box;
  padding: var(--mhp-space-6) 0 var(--mhp-space-5);
  background: var(--bg-card);
  border-right: 2rpx solid var(--bg-main);
  box-shadow: var(--shadow-md);
  overflow: hidden;
  transition: width var(--motion-normal) var(--ease-standard);
}

.sb--collapsed {
  width: calc(96rpx * var(--mhp-layout-scale));
}

/* ----- 品牌区 ----- */

.sb__brand {
  display: flex;
  align-items: center;
  gap: var(--mhp-space-4);
  padding: 0 var(--mhp-space-6) var(--mhp-space-6);
  border-bottom: 2rpx solid var(--bg-main);
}

.sb--collapsed .sb__brand {
  justify-content: center;
  padding-left: 0;
  padding-right: 0;
}

.sb__brand-ico {
  flex: none;
  width: calc(36rpx * var(--mhp-scale));
  height: calc(36rpx * var(--mhp-scale));
  color: var(--color-primary);
}

.sb__brand-text {
  min-width: 0;
  font-size: calc(28rpx * var(--mhp-scale));
  line-height: var(--mhp-lh-body);
  font-weight: var(--mhp-fw-semibold);
  color: var(--text-title);
  white-space: normal;
}

/* ----- 导航项 ----- */

.sb__nav {
  flex: 1;
  height: 0;
  box-sizing: border-box;
  padding: var(--mhp-space-5) var(--mhp-space-4);
}

/* 滚动条隐藏兜底（旧基础库 / 开发者工具无 enhanced 支持时）：wxml 的
   enhanced + show-scrollbar 是官方首选，这里仅加 ::-webkit-scrollbar 兜底；
   只隐藏视觉滚动条，不改变 .sb__nav 的高度/flex，纵向滚动照常工作。 */
.sb__nav::-webkit-scrollbar {
  width: 0;
  height: 0;
  display: none;
  color: transparent;
}

.sb__item {
  display: flex;
  align-items: center;
  gap: var(--mhp-space-4);
  box-sizing: border-box;
  margin-bottom: var(--mhp-space-2);
  padding: var(--mhp-space-5) var(--mhp-space-4);
  border-radius: var(--radius-sm);
}

.sb__item--hover {
  background: var(--bg-main);
}

.sb__item.is-active {
  background: var(--bg-main);
}

.sb--collapsed .sb__item {
  justify-content: center;
  padding-left: 0;
  padding-right: 0;
}

.sb__item-ico {
  flex: none;
  width: calc(36rpx * var(--mhp-scale));
  height: calc(36rpx * var(--mhp-scale));
  color: var(--text-body);
}

.sb__item.is-active .sb__item-ico {
  color: var(--color-primary);
}

.sb__item-label {
  min-width: 0;
  font-size: calc(28rpx * var(--mhp-scale));
  line-height: var(--mhp-lh-body);
  color: var(--text-body);
  white-space: normal;
}

.sb__item.is-active .sb__item-label {
  color: var(--color-primary);
  font-weight: var(--mhp-fw-semibold);
}

/* ----- 收起 / 展开 ----- */

.sb__toggle {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--mhp-space-3);
  margin: 0 var(--mhp-space-4);
  padding: var(--mhp-space-5);
  border-top: 2rpx solid var(--bg-main);
  border-radius: var(--radius-sm);
}

.sb__toggle-chev {
  font-size: calc(32rpx * var(--mhp-scale));
  line-height: var(--mhp-lh-title);
  color: var(--color-primary);
}

.sb__toggle-label {
  font-size: calc(24rpx * var(--mhp-scale));
  line-height: var(--mhp-lh-caption);
  color: var(--text-caption);
  white-space: nowrap;
}
