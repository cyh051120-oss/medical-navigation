/* styles/tokens.wxss — 单一设计令牌来源（任务 41）。
   色板 / 字阶 / 间距 / 圆角 / 阴影 / 动效时长 全部在此定义；app.wxss 用 @import 引入，
   页面一律消费 var(--*)，不得再写裸色值。

   缩放与高对比是任务 16 的既有契约，仍由 app.wxss 保留：
     - --mhp-scale 由 shared/ui/a11y.ts 写到页面根节点，所有字号写 calc(Nrpx * var(--mhp-scale))；
     - .is-hc 把 --mhp-hc-* 映射到语义色。本文件只提供（不消费）HC 令牌。

   注意：字号四档刻意不在这里定义成 var()，而是让页面内联
   calc(Nrpx * var(--mhp-scale))。既有 a11y 规范（tests/e2e/a11y.spec.mjs 等）用
   /calc\([^)]*var\(--mhp-scale\)\)/ 逐行扫描 wxss，嵌套 var() 会破坏该正则。 */
page {
  /* ===== Palette · surface ===== */
  --bg-main: #F6F9F7;
  --bg-accent: #E6F4EC;
  --bg-input: #F3F8F5;
  --bg-warm: #FFF4E7;
  --bg-elevated: #FFFFFF;
  --surface-action: #154C42;
  --color-on-action: #FFFFFF;
  --color-decoration: #C7EBC9;
  --border-strong: #C7DCD2;
  --border-subtle: #E0EBE5;
  --bg-card: #FFFFFF;

  /* ===== Palette · brand / semantic ===== */
  --color-primary: #0C7568;
  --color-on-primary: #FFFFFF;
  --color-warm: #925329;
  /* Danger 与品牌色分离；用于不可逆删除及错误，避免误当操作强调色。 */
  --color-danger: #B74250;
  /* A13-07：--color-success 由 ai.wxss 的 .statusbar--ok（AI 已连接）消费，
     与 --color-danger（离线/失败）构成状态色彩对；状态另有文本表达，不单靠颜色。 */
  --color-success: #1A8465;

  /* ===== Ink: 松绿墨色 / 温和次级文字，白底保证可读对比 ===== */
  --text-title: #183B34;
  --text-body: #405A51;
  --text-caption: #5A7068;

  /* ===== Palette · high contrast（任务 12/16；由 .is-hc 启用） ===== */
  --mhp-hc-bg: #000000;
  --mhp-hc-surface: #1A1A1A;
  --mhp-hc-text: #FFFFFF;
  --mhp-hc-accent: #FFD400;
  /* P1-36：高对比下 danger 独立于 accent（#FFD400），对 #1A1A1A 约 7.7:1，
     保证「错误 / 代理离线」与「主操作 / 已连接」不再同色。 */
  --mhp-hc-danger: #FF8A8A;
  --mhp-hc-border: #FFFFFF;

  /* ===== Type scale（四档版式层级，任务 41）=====
     页面标题   44rpx  lh var(--mhp-lh-title)   fw 600  color --text-title
     区块标题   32rpx  lh var(--mhp-lh-title)   fw 600  color --text-title
     正文       28rpx  lh var(--mhp-lh-body)    fw 400  color --text-body
     辅助文本   24rpx  lh var(--mhp-lh-caption) fw 400  color --text-caption
     仅尺寸（非文字层级）：统计数值 40rpx；空态徽标图标尺寸见 app.wxss（.mhp-empty__badge .mhp-ico）。 */
  --mhp-lh-title: 1.25;
  --mhp-lh-body: 1.52;
  --mhp-lh-caption: 1.4;
  --mhp-fw-semibold: 600;

  /* ===== Spacing scale（4rpx 网格；结构间距的唯一来源） ===== */
  --mhp-space-1: 4rpx;
  --mhp-space-2: 8rpx;
  --mhp-space-3: 12rpx;
  --mhp-space-4: 16rpx;
  --mhp-space-5: 20rpx;
  --mhp-space-6: 24rpx;
  --mhp-space-7: 28rpx;
  --mhp-space-8: 32rpx;
  --mhp-space-9: 40rpx;
  --mhp-space-10: 48rpx;
  --mhp-space-11: 64rpx;
  --mhp-space-12: 96rpx;

  /* ===== Radii ===== */
  --radius-xs: 12rpx;
  --radius-sm: 20rpx;
  --radius-md: 26rpx;
  --radius-lg: 36rpx;
  --radius-xl: 48rpx;

  /* ===== Elevation ===== */
  --shadow-sm: 0 4rpx 16rpx rgba(17, 75, 58, 0.035);
  --shadow-md: 0 10rpx 34rpx rgba(19, 76, 62, 0.075);
  --shadow-neon: 0 8rpx 22rpx rgba(12, 117, 104, 0.14);

  /* ===== Motion ===== */
  --motion-fast: 120ms;
  --motion-normal: 240ms;
  --motion-spin: 900ms;
  --ease-standard: ease;
}
